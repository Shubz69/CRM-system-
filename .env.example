# DM Intelligence CRM — copy to .env and fill in values

DATABASE_URL="postgresql://dmintel:dmintel@localhost:5432/dm_intelligence_crm?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Development uses the mock AI provider when unset or set to "mock"
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

MANYCHAT_API_BASE_URL="https://api.manychat.com"
MANYCHAT_API_TOKEN=
MANYCHAT_WEBHOOK_SECRET="dev-manychat-webhook-secret"

BOOKING_PROVIDER="link"
BOOKING_WEBHOOK_SECRET="dev-booking-webhook-secret"
DEFAULT_BOOKING_URL="https://calendly.com/example/intro-call"

# 32-byte key hex-encoded (64 hex chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Set to true to seed and label demo data
DEMO_MODE="true"
