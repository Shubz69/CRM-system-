# Agent Desk — copy to .env and fill in values

# Hosted (recommended): Supabase Postgres — see docs/SUPABASE.md
# Vercel runtime: Transaction pooler port 6543 + pgbouncer=true&connection_limit=1
# Local prisma migrate deploy: direct/session port 5432 (also set DIRECT_URL)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require"
# Local Docker alternative:
# DATABASE_URL="postgresql://dmintel:dmintel@localhost:5432/dm_intelligence_crm?schema=public"
# DIRECT_URL="postgresql://dmintel:dmintel@localhost:5432/dm_intelligence_crm?schema=public"
# Optional: force runtime mode (development | test | production)
# APP_RUNTIME_MODE="production"
REDIS_URL="redis://localhost:6379"
# Upstash example (TLS required): rediss://default:TOKEN@xxxx.upstash.io:6379
# Never paste a redis-cli command into REDIS_URL.
# REDIS_TLS_INSECURE="true"  # only if cert verification fails (some Windows setups)
# Long-job worker concurrency (agent-runs queue). Default 2.
# AGENT_RUNS_CONCURRENCY="2"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI — Anthropic Claude is PRIMARY and DEFAULT
# ---------------------------------------------------------------------------
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-5-20250929"
ANTHROPIC_ECONOMY_MODEL="claude-haiku-4-5-20251001"
ANTHROPIC_ADVANCED_MODEL="claude-opus-4-5"
ANTHROPIC_ECONOMY_MODEL="claude-3-5-haiku-latest"
ANTHROPIC_ADVANCED_MODEL="claude-opus-4-20250514"
# Optional tuning
# ANTHROPIC_MAX_TOKENS="2048"
# ANTHROPIC_TIMEOUT_MS="45000"
# ANTHROPIC_RETRIES="1"
# ANTHROPIC_TEMPERATURE="0.2"

# OPTIONAL — OpenAI adapter only. Not required. Production works without this.
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Research sources — Instagram / LinkedIn / TikTok via Apify (licensed provider)
# ---------------------------------------------------------------------------
# Unset → those adapters throw SourceNotConfiguredError (never fake data).
# APIFY_TOKEN=
# Optional overrides (defaults in src/adapters/sources/apify-platforms.ts):
# APIFY_TIMEOUT_MS="75000"
# APIFY_LINKEDIN_TIMEOUT_MS="55000"
# APIFY_INSTAGRAM_ACTOR_ID="apify/instagram-scraper"
# APIFY_LINKEDIN_ACTOR_ID="harvestapi/linkedin-post-search"
# APIFY_TIKTOK_ACTOR_ID="clockworks/tiktok-scraper"
# APIFY_USD_PER_1K_RESULTS="2.7"
# APIFY_RATE_LIMIT_PER_MIN="10"

MANYCHAT_API_BASE_URL="https://api.manychat.com"
MANYCHAT_API_TOKEN=
MANYCHAT_WEBHOOK_SECRET="dev-manychat-webhook-secret"

BOOKING_PROVIDER="link"
BOOKING_WEBHOOK_SECRET="dev-booking-webhook-secret"
# Optional default when an agent has no bookingUrl set (your real booking page)
# DEFAULT_BOOKING_URL=

# 32-byte key hex-encoded (64 hex chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

CRON_SECRET=

# Optional report delivery adapters (mock used when unset)
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
EMAIL_SMTP_URL=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Apify — licensed Instagram / LinkedIn / TikTok (no direct scraping)
# Unset → those adapters throw SourceNotConfiguredError (never fake data).
# ---------------------------------------------------------------------------
# APIFY_TOKEN=
# APIFY_TIMEOUT_MS="75000"
# APIFY_INSTAGRAM_TIMEOUT_MS="75000"
# APIFY_LINKEDIN_TIMEOUT_MS="55000"
# APIFY_TIKTOK_TIMEOUT_MS="75000"
# Optional actor overrides (defaults: apify/instagram-scraper,
# harvestapi/linkedin-post-search, clockworks/tiktok-scraper)
# APIFY_INSTAGRAM_ACTOR_ID=
# APIFY_LINKEDIN_ACTOR_ID=
# APIFY_TIKTOK_ACTOR_ID=
# APIFY_RATE_LIMIT_PER_MIN="10"

# ---------------------------------------------------------------------------
# Social Connections — tenants OAuth-connect their own Instagram / LinkedIn /
# TikTok account (Settings → Integrations → Social Connections) for listening
# + publishing. Unset → SocialNotConfiguredError, never a fake connection.
# Setup steps per platform: docs/SOCIAL_CONNECTIONS.md
# ---------------------------------------------------------------------------
# Meta App (Instagram API with Instagram Login) — developers.facebook.com
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI="${APP_URL}/api/social/instagram/callback"
# INSTAGRAM_GRAPH_API_VERSION="v21.0"

# LinkedIn app — www.linkedin.com/developers/apps (personal-profile posting only;
# no messaging — see docs/SOCIAL_CONNECTIONS.md)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI="${APP_URL}/api/social/linkedin/callback"

# TikTok for Developers app — developers.tiktok.com (Content Posting API;
# no messaging — no third-party TikTok DM API exists)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI="${APP_URL}/api/social/tiktok/callback"

# Super administrator seed (never commit real passwords)
ADMIN_EMAIL="1230shobhit@gmail.com"
ADMIN_INITIAL_PASSWORD=
ADMIN_FORCE_PASSWORD_CHANGE="true"
# Required to call POST /api/admin/bootstrap on Vercel (16+ chars). Rotate after first use.
ADMIN_BOOTSTRAP_SECRET=
