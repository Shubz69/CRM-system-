  id               String               @id @default(cuid())
  organisationId   String
  taskType         String
  executionMode    ComputeExecutionMode
  selectedModel    String?
  selectedProvider String?
  reasonCodes      String[]             @default([])
  escalationReason String?
  estimatedCostCents Int?
  actualCostCents  Int?
