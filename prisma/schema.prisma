  organisationId String
  provider       String
  model          String
  taskType       String
  feature        String?
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  latencyMs      Int?
  success        Boolean  @default(true)
  error          String?
  estimatedCost  Float?
  metadata       Json     @default("{}")
