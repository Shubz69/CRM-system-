  toolKey              String
  provider             String          @default("builtin")
  origin               String          @default("first_party")
  version              String
  definitionHash       String
  permissions          String[]        @default([])
  dataClasses          String[]        @default([])
  sideEffects          String[]        @default([])
  externalDestinations String[]        @default([])
  riskLevel            String          @default("read")
