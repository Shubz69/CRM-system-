  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
