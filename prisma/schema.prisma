generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Direct (non-pooled) URL for migrate deploy. Fall back to DATABASE_URL locally.
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum MemberRole {
  SUPER_ADMIN
  OWNER
  ADMINISTRATOR
  MANAGER
  SALES_AGENT
  ANALYST
  READ_ONLY
}

enum QualificationStatus {
  UNKNOWN
  QUALIFYING
  QUALIFIED
  DISQUALIFIED
}

enum HandlingMode {
  AI
  HUMAN
  PAUSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CONTACT
  AI
  HUMAN
  SYSTEM
}

enum BookingStatus {
  OFFERED
  CREATED
  RESCHEDULED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum FollowUpStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum KnowledgeDocStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
  IGNORED
}

enum IntegrationType {
  MANYCHAT
  OPENAI
  ANTHROPIC
  BOOKING
  GOOGLE_SHEETS
  EMAIL
  WEBHOOK
}

enum NotificationType {
  HANDOVER
  HIGH_SCORE
  NEGATIVE_SENTIMENT
  BOOKING
  SYSTEM
  TASK
  AI_FAILURE
  FOLLOW_UP_FAILURE
  AUTOMATION_FAILURE
  UNASSIGNED_QUALIFIED
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

enum AutopilotMode {
  OFF
  TEST
  LIVE
  PAUSED
  ATTENTION_REQUIRED
}

enum AuditLogScope {
  ORG
  PLATFORM
}

model Organisation {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  timezone       String   @default("UTC")
  dataRetentionDays Int   @default(365)
  demoData       Boolean  @default(false)
  /// True for the sentinel platform org — never delete; holds non-tenant ledger rows.
  isPlatform     Boolean  @default(false)
  status         OrganisationStatus @default(ACTIVE)
  plan           String   @default("standard")
  autopilotMode  AutopilotMode @default(LIVE)
  /// Capability modes: automatic | approval_required | disabled
  autopilotConfig Json    @default("{}")
  lastActivityAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  members              OrganisationMember[]
  integrations         Integration[]
  messagingChannels    MessagingChannel[]
  contacts             Contact[]
  conversations        Conversation[]
  leads                Lead[]
  pipelines            Pipeline[]
  tags                 Tag[]
  knowledgeDocuments   KnowledgeDocument[]
  agentConfigurations  AgentConfiguration[]
  automationRules      AutomationRule[]
  bookings             Booking[]
  followUps            FollowUp[]
  campaigns            Campaign[]
  dailyMetrics         DailyMetric[]
  reports              Report[]
  webhookEvents        WebhookEvent[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  qualificationFields  QualificationField[]
  objections           Objection[]
  detectedQuestions    DetectedQuestion[]
  buyingSignals        BuyingSignal[]
  conversationInsights ConversationInsight[]
  notes                Note[]
  attributions         Attribution[]
  knowledgeRecommendations KnowledgeRecommendation[]
  failedJobs           FailedJob[]
  usageRecords         UsageRecord[]
  aiExecutions         AiExecution[]
  aiBudget             OrganisationAiBudget?
  agentRuns            AgentRun[]
  agentSteps           AgentStep[]
  toolCalls            ToolCall[]
  agentLimits          OrganisationAgentLimits?
  agentRetention       OrganisationAgentRetention?
  knowledgeChunks      KnowledgeChunk[]
  researchJobs         ResearchJob[]
  researchSources      ResearchSource[]
  researchFindings     ResearchFinding[]
  socialPosts          SocialPost[]
  trendSignals         TrendSignal[]
  assets               Asset[]
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String?
  image                String?
  emailVerified        DateTime?
  mustChangePassword   Boolean   @default(false)
  isActive             Boolean   @default(true)
  isSuspended          Boolean   @default(false)
  isPlatformAdmin      Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  /// Last workspace the user explicitly used (login default / switcher).
  activeOrganisationId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  accounts              Account[]
  sessions              Session[]
  memberships           OrganisationMember[]
  assignedConversations ConversationAssignment[]
  notes                 Note[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  agentRuns             AgentRun[]
  assetsCreated         Asset[]

  @@index([activeOrganisationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OrganisationMember {
  id             String     @id @default(cuid())
  organisationId String
  userId         String
  role           MemberRole @default(SALES_AGENT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

model Integration {
  id             String          @id @default(cuid())
  organisationId String
  type           IntegrationType
  name           String
  isActive       Boolean         @default(false)
  config         Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  credentials  IntegrationCredential[]

  @@unique([organisationId, type, name])
  @@index([organisationId, type])
}

model IntegrationCredential {
  id            String   @id @default(cuid())
  integrationId String
  keyName       String
  encryptedValue String  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, keyName])
}

model MessagingChannel {
  id             String   @id @default(cuid())
  organisationId String
  provider       String   @default("manychat")
  externalId     String?
  displayName    String
  instagramUsername String?
  isActive       Boolean  @default(true)
  config         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  conversations Conversation[]

  @@unique([organisationId, provider, externalId])
  @@index([organisationId])
}

model Contact {
  id               String    @id @default(cuid())
  organisationId   String
  messagingChannelId String?
  fullName         String?
  instagramUsername String?
  email            String?
  phone            String?
  location         String?
  timezone         String?
  leadSource       String?
  campaignSource   String?
  firstContactAt   DateTime  @default(now())
  lastContactAt    DateTime  @default(now())
  optedOut         Boolean   @default(false)
  optedOutAt       DateTime?
  consentGiven     Boolean   @default(true)
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organisation     Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  messagingChannel MessagingChannel?  @relation(fields: [messagingChannelId], references: [id])
  identifiers      ContactIdentifier[]
  conversations    Conversation[]
  leads            Lead[]
  tags             ContactTag[]
  notes            Note[]
  bookings         Booking[]
  followUps        FollowUp[]
  attributions     Attribution[]

  @@index([organisationId, lastContactAt])
  @@index([organisationId, email])
  @@index([organisationId, phone])
  @@index([organisationId, instagramUsername])
}

model ContactIdentifier {
  id             String   @id @default(cuid())
  organisationId String
  contactId      String
  channel        String
  identifier     String
  createdAt      DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organisationId, channel, identifier])
  @@index([contactId])
}

model Conversation {
  id                             String       @id @default(cuid())
  organisationId                 String
  contactId                      String
  messagingChannelId             String?
  externalThreadId               String?
  subject                        String?
  handlingMode                   HandlingMode @default(AI)
  unreadCount                    Int          @default(0)
  lastMessageAt                  DateTime?
  lastMessagePreview             String?
  lastInboundAt                  DateTime?
  lastOutboundAt                 DateTime?
  messagingWindowExpiresAt       DateTime?
  humanMessagingWindowExpiresAt  DateTime?
  handoffReason                  String?
  aiPaused                       Boolean      @default(false)
  needsHumanReview               Boolean      @default(false)
  summary                        String?      @db.Text
  intent                         String?
  sentiment                      String?
  metadata                       Json         @default("{}")
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  deletedAt                      DateTime?

  organisation     Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact          Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messagingChannel MessagingChannel?        @relation(fields: [messagingChannelId], references: [id])
  messages         Message[]
  leads            Lead[]
  assignments      ConversationAssignment[]
  notes            Note[]
  bookings         Booking[]
  followUps        FollowUp[]
  objections       Objection[]
  questions        DetectedQuestion[]
  buyingSignals    BuyingSignal[]
  insights         ConversationInsight[]
  tags             ConversationTag[]

  @@unique([organisationId, externalThreadId])
  @@index([organisationId, lastMessageAt])
  @@index([organisationId, needsHumanReview])
  @@index([contactId])
}

model ConversationAssignment {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  assignedAt     DateTime @default(now())
  active         Boolean  @default(true)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, active])
  @@index([userId])
}

model Message {
  id               String             @id @default(cuid())
  conversationId   String
  organisationId   String
  externalId       String?
  direction        MessageDirection
  senderType       MessageSenderType
  body             String             @db.Text
  /// Provenance: "simulator", "manychat", "integration_test", etc. Null for legacy rows.
  origin           String?
  rawPayload       Json?
  aiMetadata       Json?
  deliveryStatus   String?
  sentAt           DateTime           @default(now())
  createdAt        DateTime           @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
  @@index([organisationId, sentAt])
  @@index([organisationId, origin])
}

model Pipeline {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  leads        Lead[]

  @@unique([organisationId, name])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  slug       String
  position   Int
  color      String   @default("#64748b")
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, slug])
  @@index([pipelineId, position])
}

model Lead {
  id                   String              @id @default(cuid())
  organisationId       String
  contactId            String
  conversationId       String?
  pipelineId           String?
  stageId              String?
  qualificationStatus  QualificationStatus @default(UNKNOWN)
  score                Int                 @default(0)
  scoreExplanation     String?             @db.Text
  estimatedValue       Decimal?            @db.Decimal(12, 2)
  ownerUserId          String?
  campaignId           String?
  summary              String?             @db.Text
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact        Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation?         @relation(fields: [conversationId], references: [id])
  pipeline       Pipeline?             @relation(fields: [pipelineId], references: [id])
  stage          PipelineStage?        @relation(fields: [stageId], references: [id])
  campaign       Campaign?             @relation(fields: [campaignId], references: [id])
  scores         LeadScore[]
  scoreEvents    LeadScoreEvent[]
  answers        QualificationAnswer[]
  bookings       Booking[]
  followUps      FollowUp[]
  attributions   Attribution[]

  @@index([organisationId, qualificationStatus])
  @@index([organisationId, score])
  @@index([organisationId, stageId, updatedAt])
  @@index([contactId])
  @@index([conversationId])
}

model QualificationField {
  id                   String   @id @default(cuid())
  organisationId       String
  key                  String
  label                String
  description          String?
  fieldType            String   @default("short_text")
  required             Boolean  @default(false)
  weight               Int      @default(10)
  position             Int      @default(0)
  active               Boolean  @default(true)
  options              Json     @default("[]")
  disqualifyingAnswers Json     @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  answers      QualificationAnswer[]

  @@unique([organisationId, key])
}

model QualificationAnswer {
  id        String   @id @default(cuid())
  leadId    String
  fieldId   String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead  Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field QualificationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
}

model LeadScore {
  id          String   @id @default(cuid())
  leadId      String
  totalScore  Int
  explanation String?  @db.Text
  calculatedAt DateTime @default(now())

  lead       Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  components LeadScoreComponent[]

  @@index([leadId, calculatedAt])
}

model LeadScoreComponent {
  id          String @id @default(cuid())
  leadScoreId String
  factor      String
  points      Int
  reason      String

  leadScore LeadScore @relation(fields: [leadScoreId], references: [id], onDelete: Cascade)

  @@index([leadScoreId])
}

model Booking {
  id             String        @id @default(cuid())
  organisationId String
  contactId      String
  conversationId String?
  leadId         String?
  provider       String        @default("link")
  externalId     String?
  status         BookingStatus @default(CREATED)
  scheduledAt    DateTime?
  bookingUrl     String?
  attribution    Json          @default("{}")
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])

  @@unique([organisationId, provider, externalId])
  @@index([organisationId, status])
  @@index([contactId])
}

model FollowUp {
  id             String         @id @default(cuid())
  organisationId String
  contactId      String
  conversationId String?
  leadId         String?
  status         FollowUpStatus @default(SCHEDULED)
  scheduledFor   DateTime
  attemptNumber  Int            @default(1)
  messageBody    String?        @db.Text
  cancelReason   String?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])

  @@index([organisationId, status, scheduledFor])
  @@index([conversationId, status])
}

model AutomationRule {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  description    String?
  triggerType    String
  conditions     Json     @default("{}")
  actions        Json     @default("[]")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([organisationId, isActive])
}

model AutomationExecution {
  id        String   @id @default(cuid())
  ruleId    String
  status    String
  context   Json     @default("{}")
  result    Json?
  error     String?
  createdAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
}

model Tag {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  color          String   @default("#64748b")
  createdAt      DateTime @default(now())

  organisation  Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contacts      ContactTag[]
  conversations ConversationTag[]

  @@unique([organisationId, name])
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model Note {
  id             String   @id @default(cuid())
  organisationId String
  contactId      String?
  conversationId String?
  authorId       String?
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?         @relation(fields: [authorId], references: [id])

  @@index([organisationId, createdAt])
  @@index([contactId, createdAt])
  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id             String             @id @default(cuid())
  organisationId String
  title          String
  category       String
  content        String             @db.Text
  contentType    String             @default("markdown")
  status         KnowledgeDocStatus @default(ACTIVE)
  tags           String[]           @default([])
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]
  versions     KnowledgeVersion[]

  @@index([organisationId, status, category])
}

model KnowledgeVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  content    String   @db.Text
  createdAt  DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model KnowledgeChunk {
  id             String                       @id @default(cuid())
  /// Denormalised for org-scoped SQL retrieval (never join-only).
  organisationId String
  documentId     String
  content        String                       @db.Text
  tokens         Int?
  metadata       Json                         @default("{}")
  /// pgvector cosine embedding; null until embedded or when provider unset.
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddedAt     DateTime?
  createdAt      DateTime                     @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([organisationId])
  @@index([organisationId, embeddedAt])
}

model AgentConfiguration {
  id                      String   @id @default(cuid())
  organisationId          String
  name                    String   @default("Default Agent")
  isActive                Boolean  @default(true)
  isDraft                 Boolean  @default(false)
  version                 Int      @default(1)
  publishedVersion        Int?
  aiProvider              String   @default("anthropic")
  model                   String   @default("claude-sonnet-4-20250514")
  brandTone               String   @default("professional, helpful, concise")
  formality               String   @default("professional")
  responseLength          String   @default("medium")
  emojiUsage              String   @default("minimal")
  language                String   @default("en")
  qualificationQuestions  Json     @default("[]")
  scoringRules            Json     @default("{}")
  bookingConditions       Json     @default("{}")
  disqualificationRules   Json     @default("[]")
  handoverRules           Json     @default("{}")
  followUpDelaysMinutes   Json     @default("[60, 1440, 4320]")
  maxFollowUps            Int      @default(3)
  operatingHours          Json     @default("{}")
  restrictedTopics        Json     @default("[]")
  optOutKeywords          Json     @default("[\"stop\",\"unsubscribe\",\"opt out\"]")
  confidenceThreshold     Float    @default(0.65)
  bookingUrl              String?
  systemPromptExtra       String?  @db.Text
  escalationInstructions  String?  @db.Text
  lastEditedById          String?
  lastPublishedById       String?
  publishedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, isActive])
}

model Objection {
  id             String   @id @default(cuid())
  organisationId String
  conversationId String?
  category       String
  text           String
  detectedAt     DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([organisationId, category, detectedAt])
}

model DetectedQuestion {
  id             String   @id @default(cuid())
  organisationId String
  conversationId String?
  text           String
  detectedAt     DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([organisationId, detectedAt])
}

model BuyingSignal {
  id             String   @id @default(cuid())
  organisationId String
  conversationId String?
  text           String
  detectedAt     DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([organisationId, detectedAt])
}

model ConversationInsight {
  id             String   @id @default(cuid())
  organisationId String
  conversationId String?
  type           String
  title          String
  summary        String   @db.Text
  evidenceCount  Int      @default(1)
  confidence     Float    @default(0.5)
  trend          String?
  recommendedAction String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([organisationId, type, createdAt])
}

model DailyMetric {
  id                   String   @id @default(cuid())
  organisationId       String
  date                 DateTime @db.Date
  totalConversations   Int      @default(0)
  newLeads             Int      @default(0)
  qualifiedLeads       Int      @default(0)
  disqualifiedLeads    Int      @default(0)
  callsBooked          Int      @default(0)
  aiHandled            Int      @default(0)
  humanTakeovers       Int      @default(0)
  followUpsSent        Int      @default(0)
  avgResponseTimeSec   Float?
  metadata             Json     @default("{}")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, date])
}

model Campaign {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  source         String?
  externalId     String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  attributions Attribution[]

  @@unique([organisationId, name])
}

model Attribution {
  id             String   @id @default(cuid())
  organisationId String
  contactId      String
  leadId         String?
  campaignId     String?
  source         String?
  medium         String?
  content        String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([organisationId, createdAt])
  @@index([contactId])
  @@index([campaignId])
}

model Report {
  id             String   @id @default(cuid())
  organisationId String
  type           String
  periodStart    DateTime
  periodEnd      DateTime
  title          String
  payload        Json
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, type, periodStart])
}

model WebhookEvent {
  id             String                  @id @default(cuid())
  organisationId String
  provider       String
  eventType      String
  idempotencyKey String
  payload        Json
  status         WebhookProcessingStatus @default(RECEIVED)
  error          String?
  processedAt    DateTime?
  createdAt      DateTime                @default(now())

  /// Restrict: hard-deleting an org must not silently wipe webhook forensics.
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([provider, idempotencyKey])
  @@index([organisationId, createdAt])
  @@index([status])
}

model AuditLog {
  id             String        @id @default(cuid())
  /// ORG = tenant event (organisationId required). PLATFORM = platform event (organisationId null).
  scope          AuditLogScope @default(ORG)
  organisationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  /// Restrict: compliance trail outlives accidental org hard-delete.
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organisationId, createdAt])
  @@index([scope, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id             String           @id @default(cuid())
  organisationId String
  userId         String?
  type           NotificationType
  title          String
  body           String
  readAt         DateTime?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organisationId, userId, readAt])
}

model KnowledgeRecommendation {
  id             String   @id @default(cuid())
  organisationId String
  conversationId String?
  question       String
  draftAnswer    String?
  reason         String?
  status         String   @default("NEW") // NEW REVIEWED APPROVED DISMISSED USED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
}

model LeadScoreEvent {
  id            String   @id @default(cuid())
  leadId        String
  previousScore Int
  newScore      Int
  delta         Int
  reason        String
  ruleKey       String?
  messageId     String?
  createdAt     DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model FailedJob {
  id             String    @id @default(cuid())
  organisationId String
  queue          String
  jobName        String
  payload        Json      @default("{}")
  error          String
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  /// Restrict: ops failure history must not vanish with the tenant row.
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([queue, createdAt])
  @@index([organisationId, createdAt])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organisationId String
  feature        String
  provider       String?
  quantity       Int      @default(1)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  /// Restrict: billing/usage ledger survives org hard-delete attempts.
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, feature, createdAt])
}

/// Detailed AI call ledger — Anthropic-first; OpenAI optional if ever enabled.
model AiExecution {
  id             String   @id @default(cuid())
  organisationId String
  provider       String
  model          String
  taskType       String
  feature        String?
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  latencyMs      Int?
  success        Boolean  @default(true)
  error          String?
  estimatedCost  Float?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  /// Restrict: AI spend history must be exported before an org can be purged.
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, createdAt])
  @@index([provider, model, createdAt])
  @@index([taskType, createdAt])
  @@index([success, createdAt])
}

/// Per-organisation AI spend cap (cents). Null monthlyCapCents = unlimited.
/// Period spend is computed from AiExecution — this table is the gate config only.
model OrganisationAiBudget {
  id              String   @id @default(cuid())
  organisationId  String   @unique
  /// Monthly cap in USD cents. null = no cap (existing behaviour).
  monthlyCapCents Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

enum AgentRunStatus {
  PENDING
  PLANNING
  AWAITING_CLARIFICATION
  /// Imaging: derived prompt shown for edit/confirm before generation spend.
  AWAITING_PROMPT_CONFIRM
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// How much AgentStep.input/output is retained after age thresholds.
enum AgentDetailRetention {
  FULL
  COMPACT
  SKELETON
}

/// AgentRun.partialResults retention (finalOutput is never pruned).
enum PartialResultsRetention {
  FULL
  SUMMARY
}

/// Per-org hard limits for multi-agent runs.
model OrganisationAgentLimits {
  id                   String   @id @default(cuid())
  organisationId       String   @unique
  maxSteps             Int      @default(8)
  maxWallClockSeconds  Int      @default(600)
  /// Cap for a single run in cents. null = use monthly spend gate only.
  maxSpendCentsPerRun  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

/// Per-org agent artifact retention windows (days). Sensible defaults match product policy.
model OrganisationAgentRetention {
  id                     String   @id @default(cuid())
  organisationId         String   @unique
  /// ToolCall.args / result cleared after this many days (debug-only blobs).
  toolCallPayloadDays    Int      @default(14)
  /// AgentStep input/output kept full, then compact preview.
  stepFullDetailDays     Int      @default(30)
  /// After this age, steps are label/status/cost skeleton only.
  stepSkeletonAfterDays  Int      @default(180)
  /// AgentRun.partialResults full, then collapsed to a short summary.
  partialResultsFullDays Int      @default(30)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id                      String                  @id @default(cuid())
  organisationId          String
  /// Null when triggered by system/schedule (recurring runs later).
  userId                  String?
  /// user | system | schedule
  triggeredBy             String                  @default("user")
  request                 String                  @db.Text
  plan                    Json?
  plainEnglishPlan        String?                 @db.Text
  clarificationQuestion   String?                 @db.Text
  clarificationOptions    Json?
  status                  AgentRunStatus          @default(PENDING)
  startedAt               DateTime?
  finishedAt              DateTime?
  totalCostCents          Int                     @default(0)
  error                   String?                 @db.Text
  userFacingError         String?                 @db.Text
  partialResults          Json?
  partialResultsRetention PartialResultsRetention @default(FULL)
  /// First-class output artifact for later save/share/export. Kept indefinitely.
  finalOutput             Json?
  /// Imaging: proposed generation prompt awaiting user edit/confirm.
  pendingPrompt           String?                 @db.Text
  pendingBrief            Json?
  pendingCostEstimateCents Int?
  referenceAssetId        String?
  maxSteps                Int                     @default(8)
  maxWallClockSeconds     Int                     @default(600)
  maxSpendCents           Int?
  bullJobId               String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  referenceAsset Asset?       @relation("AgentRunReferenceAsset", fields: [referenceAssetId], references: [id], onDelete: SetNull)
  steps          AgentStep[]

  @@index([organisationId, createdAt])
  @@index([organisationId, status])
  @@index([organisationId, partialResultsRetention, createdAt])
  @@index([bullJobId])
  @@index([referenceAssetId])
}

model AgentStep {
  id               String               @id @default(cuid())
  organisationId   String
  agentRunId       String
  position         Int
  agentName        String
  /// Plain-English label shown to users. Never empty.
  userFacingLabel  String
  input            Json
  output           Json?
  model            String?
  tokensIn         Int?
  tokensOut        Int?
  costCents        Int                  @default(0)
  durationMs       Int?
  status           AgentStepStatus      @default(PENDING)
  userFacingStatus String?
  detailRetention  AgentDetailRetention @default(FULL)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  toolCalls    ToolCall[]

  @@index([organisationId, agentRunId])
  @@index([organisationId, createdAt])
  @@index([organisationId, detailRetention, createdAt])
  @@index([agentRunId, position])
}

model ToolCall {
  id               String    @id @default(cuid())
  organisationId   String
  agentStepId      String
  toolName         String
  args             Json      @default("{}")
  result           Json?
  durationMs       Int?
  error            String?   @db.Text
  /// Set when args/result payloads were cleared by retention.
  payloadClearedAt DateTime?
  createdAt        DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agentStep    AgentStep    @relation(fields: [agentStepId], references: [id], onDelete: Cascade)

  @@index([organisationId, agentStepId])
  @@index([organisationId, payloadClearedAt, createdAt])
  @@index([agentStepId, createdAt])
}


enum ResearchJobKind {
  RESEARCH
  SOCIAL_LISTENING
}

enum ResearchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

/// Org-scoped research / social-listening run (paired with AgentRun when started from Ask).
model ResearchJob {
  id              String            @id @default(cuid())
  organisationId  String
  agentRunId      String?
  kind            ResearchJobKind
  topic           String            @db.Text
  status          ResearchJobStatus @default(PENDING)
  /// Expanded search queries used for this job.
  queries         Json              @default("[]")
  /// Analyst brief (claims must cite source URLs).
  brief           Json?
  contradictions  Json?
  gaps            Json?
  criticReport    Json?
  totalCostCents  Int               @default(0)
  error           String?           @db.Text
  userFacingError String?           @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sources      ResearchSource[]
  findings     ResearchFinding[]
  socialPosts  SocialPost[]
  trendSignals TrendSignal[]

  @@index([organisationId, createdAt])
  @@index([organisationId, status])
  @@index([organisationId, kind, createdAt])
  @@index([agentRunId])
}

model ResearchSource {
  id             String    @id @default(cuid())
  organisationId String
  researchJobId  String
  url            String
  title          String?
  platform       String
  author         String?
  publishedAt    DateTime?
  content        String?   @db.Text
  engagement     Json?
  rawMetadata    Json      @default("{}")
  queryUsed      String?
  createdAt      DateTime  @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob  ResearchJob       @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  findings     ResearchFinding[]
  socialPosts  SocialPost[]

  @@unique([researchJobId, url])
  @@index([organisationId, researchJobId])
  @@index([organisationId, platform, createdAt])
}

/// A claim grounded in exactly one source URL (via ResearchSource).
model ResearchFinding {
  id                  String   @id @default(cuid())
  organisationId      String
  researchJobId       String
  researchSourceId    String
  claim               String   @db.Text
  evidenceExcerpt     String?  @db.Text
  confidence          Float?
  verifiedByCritic    Boolean  @default(false)
  flaggedUnsupported  Boolean  @default(false)
  createdAt           DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob  ResearchJob   @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  source       ResearchSource @relation(fields: [researchSourceId], references: [id], onDelete: Cascade)

  @@index([organisationId, researchJobId])
  @@index([organisationId, researchSourceId])
}

model SocialPost {
  id                  String    @id @default(cuid())
  organisationId      String
  researchJobId       String
  researchSourceId    String?
  platform            String
  url                 String
  title               String?
  author              String?
  publishedAt         DateTime?
  content             String?   @db.Text
  engagement          Json?
  extractedThemes     Json      @default("[]")
  extractedHooks      Json      @default("[]")
  extractedFormats    Json      @default("[]")
  extractedQuestions  Json      @default("[]")
  extractedComplaints Json      @default("[]")
  createdAt           DateTime  @default(now())

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob  ResearchJob    @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  source       ResearchSource? @relation(fields: [researchSourceId], references: [id], onDelete: SetNull)

  @@unique([researchJobId, url])
  @@index([organisationId, researchJobId])
  @@index([organisationId, platform, createdAt])
}

model TrendSignal {
  id             String   @id @default(cuid())
  organisationId String
  researchJobId  String
  /// theme | hook | format | question | complaint
  signalType     String
  label          String
  frequency      Int      @default(1)
  evidenceUrls   String[] @default([])
  summary        String?  @db.Text
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob  ResearchJob  @relation(fields: [researchJobId], references: [id], onDelete: Cascade)

  @@index([organisationId, researchJobId])
  @@index([organisationId, signalType, frequency])
}


/// Org-scoped media asset (reference uploads + generated images). Bytes live in object storage.
model Asset {
  id                 String   @id @default(cuid())
  organisationId     String
  /// Opaque object locator from storage (may be a private Blob URL).
  /// Never serve this to browsers as a public link — mint a signed/read-time URL instead.
  url                String
  /// Canonical org-scoped object key used for reads and provenance (`org/{organisationId}/…`).
  storageKey         String
  prompt             String?  @db.Text
  derivedFromAssetId String?
  provider           String?
  model              String?
  costCents          Int      @default(0)
  createdByUserId    String?
  width              Int?
  height             Int?
  mimeType           String
  /// reference | generated
  kind               String   @default("reference")
  createdAt          DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  derivedFrom  Asset?       @relation("AssetDerivations", fields: [derivedFromAssetId], references: [id], onDelete: SetNull)
  derivatives  Asset[]      @relation("AssetDerivations")
  agentRunsAsReference AgentRun[] @relation("AgentRunReferenceAsset")

  @@unique([organisationId, storageKey])
  @@index([organisationId, createdAt])
  @@index([organisationId, kind, createdAt])
  @@index([derivedFromAssetId])
  @@index([createdByUserId])
}

