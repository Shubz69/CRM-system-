generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Direct (non-pooled) URL for migrate deploy. Fall back to DATABASE_URL locally.
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum MemberRole {
  SUPER_ADMIN
  OWNER
  ADMINISTRATOR
  MANAGER
  SALES_AGENT
  ANALYST
  READ_ONLY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AgentAnswerMode {
  QUICK
  EXECUTIVE
  ACTION
  DEEP
}

enum QualificationStatus {
  UNKNOWN
  QUALIFYING
  QUALIFIED
  DISQUALIFIED
}

enum HandlingMode {
  AI
  HUMAN
  PAUSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CONTACT
  AI
  HUMAN
  SYSTEM
}

enum BookingStatus {
  OFFERED
  CREATED
  RESCHEDULED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum FollowUpStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum KnowledgeDocStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
  IGNORED
}

enum IntegrationType {
  MANYCHAT
  META_INSTAGRAM
  AYRSHARE
  ZERNIO
  OPENAI
  ANTHROPIC
  BOOKING
  GOOGLE_SHEETS
  EMAIL
  WEBHOOK
}

/// Platforms a tenant can OAuth-connect their own account to (Settings → Integrations).
/// Distinct from SocialPost.platform (a free-text string used by the research/listening
/// pipeline, which reads public content and is not tied to a connected account).
enum SocialPlatform {
  INSTAGRAM
  LINKEDIN
  TIKTOK
}

enum SocialConnectionStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum NotificationType {
  HANDOVER
  HIGH_SCORE
  NEGATIVE_SENTIMENT
  BOOKING
  SYSTEM
  TASK
  AI_FAILURE
  FOLLOW_UP_FAILURE
  AUTOMATION_FAILURE
  UNASSIGNED_QUALIFIED
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

enum AutopilotMode {
  OFF
  TEST
  LIVE
  PAUSED
  ATTENTION_REQUIRED
}

enum AuditLogScope {
  ORG
  PLATFORM
}

model Organisation {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  timezone       String   @default("UTC")
  dataRetentionDays Int   @default(365)
  demoData       Boolean  @default(false)
  /// True for the sentinel platform org — never delete; holds non-tenant ledger rows.
  isPlatform     Boolean  @default(false)
  status         OrganisationStatus @default(ACTIVE)
  plan           String   @default("standard")
  /// Snapshot of resolved plan entitlements (capability → enabled). Config, not billing truth.
  entitlementSnapshot Json @default("{}")
  autopilotMode  AutopilotMode @default(LIVE)
  /// Capability modes: automatic | approval_required | disabled
  autopilotConfig Json    @default("{}")
  /// Industry workspace template key (agency | b2b_saas | creator | coaching | generic).
  industryTemplateKey  String?
  /// Applied template config snapshot — config, not a product fork.
  industryTemplateConfig Json @default("{}")
  lastActivityAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  members              OrganisationMember[]
  invitations          OrganisationInvitation[]
  integrations         Integration[]
  messagingChannels    MessagingChannel[]
  socialConnections    SocialConnection[]
  contacts             Contact[]
  conversations        Conversation[]
  leads                Lead[]
  companies            Company[]
  deals                Deal[]
  crmActivities        CrmActivity[]
  pipelines            Pipeline[]
  tags                 Tag[]
  knowledgeDocuments   KnowledgeDocument[]
  agentConfigurations  AgentConfiguration[]
  automationRules      AutomationRule[]
  approvalRequests     ApprovalRequest[]
  bookings             Booking[]
  followUps            FollowUp[]
  campaigns            Campaign[]
  dailyMetrics         DailyMetric[]
  reports              Report[]
  webhookEvents        WebhookEvent[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  qualificationFields  QualificationField[]
  objections           Objection[]
  detectedQuestions    DetectedQuestion[]
  buyingSignals        BuyingSignal[]
  conversationInsights ConversationInsight[]
  notes                Note[]
  attributions         Attribution[]
  knowledgeRecommendations KnowledgeRecommendation[]
  failedJobs           FailedJob[]
  usageRecords         UsageRecord[]
  aiExecutions         AiExecution[]
  aiBudget             OrganisationAiBudget?
  agentRuns            AgentRun[]
  agentSteps           AgentStep[]
  toolCalls            ToolCall[]
  agentLimits          OrganisationAgentLimits?
  agentRetention       OrganisationAgentRetention?
  knowledgeChunks      KnowledgeChunk[]
  researchJobs         ResearchJob[]
  researchSources      ResearchSource[]
  researchFindings     ResearchFinding[]
  researchSourceSnapshots ResearchSourceSnapshot[]
  socialPosts          SocialPost[]
  trendSignals         TrendSignal[]
  socialCreators       SocialCreator[]
  socialContents       SocialContent[]
  socialMetricSnapshots SocialMetricSnapshot[]
  trendClusters        TrendCluster[]
  trendFeatureSnapshots TrendFeatureSnapshot[]
  algorithmChanges     AlgorithmChange[]
  trendForecasts       TrendForecast[]
  trendForecastOutcomes TrendForecastOutcome[]
  contentOpportunities ContentOpportunity[]
  contentIdeas         ContentIdea[]
  creativeBriefs       CreativeBrief[]
  contentPieces        ContentPiece[]
  contentVersions      ContentVersion[]
  contentVariants      ContentVariant[]
  contentApprovals     ContentApproval[]
  publishingJobs       PublishingJob[]
  postPerformances     PostPerformance[]
  assets               Asset[]
  memoryEpisodes       MemoryEpisode[]
  memoryEntityFacts    MemoryEntityFact[]
  memoryPerformanceOutcomes MemoryPerformanceOutcome[]
  organisationPreferences OrganisationPreference[]
  recommendationFeedbacks RecommendationFeedback[]
  experiments          Experiment[]
  agentVersionCandidates AgentVersionCandidate[]
  evalSuites           EvalSuite[]
  evalRuns             EvalRun[]
  entitlements         Entitlement[]
  usageMeters          UsageMeter[]
  agentMissions        AgentMission[]
  missionTasks         MissionTask[]
  missionCheckpoints   MissionCheckpoint[]
  missionArtifacts     MissionArtifact[]
  missionOutcomes      MissionOutcome[]
  domainEvents         DomainEvent[]
  domainEventConsumptions DomainEventConsumption[]
  goals                Goal[]
  kpiDefinitions       KpiDefinition[]
  kpiTargets           KpiTarget[]
  kpiSnapshots         KpiSnapshot[]
  initiatives          Initiative[]
  goalLinks            GoalLink[]
  productOfferings     ProductOffering[]
  audienceSegments     AudienceSegment[]
  entityRelations      EntityRelation[]
  businessClaims       BusinessClaim[]
  businessOpportunities BusinessOpportunity[]
  opportunityEvidences OpportunityEvidence[]
  opportunityOutcomes  OpportunityOutcome[]
  opportunityDetectorRuns OpportunityDetectorRun[]
  connectorCapabilityStates ConnectorCapabilityState[]
  externalObjectMappings ExternalObjectMapping[]
  syncCursors          SyncCursor[]
  syncRuns             SyncRun[]
  connectorRateLimits  ConnectorRateLimitState[]
  connectorCircuits    ConnectorCircuitState[]
  providerHealthEvents ProviderHealthEvent[]
  skillDefinitions     SkillDefinition[]
  skillExecutions      SkillExecution[]
  connectorOperationLogs ConnectorOperationLog[]
  intelligenceClaims   IntelligenceClaim[]
  qualityAssessments   QualityAssessment[]
  intelligencePredictions IntelligencePrediction[]
  predictionEvaluations PredictionEvaluation[]
  confidenceCalibrationSamples ConfidenceCalibrationSample[]
  versionPerformanceSnapshots VersionPerformanceSnapshot[]
  operationalSloSnapshots OperationalSloSnapshot[]
  costOutcomeLinks     CostOutcomeLink[]
  continuousCollectionRuns ContinuousCollectionRun[]
  // Phase 20 — Differentiation intelligence
  computeDecisions     ComputeDecision[]
  computeAggregates    ComputeAggregate[]
  stateSnapshots       StateSnapshot[]
  stateTransitions     StateTransition[]
  stateEvidenceLinks   StateEvidenceLink[]
  evidenceDebtItems    EvidenceDebtItem[]
  decisions            Decision[]
  decisionAlternatives DecisionAlternative[]
  decisionEvidenceLinks DecisionEvidenceLink[]
  decisionOutcomes     DecisionOutcome[]
  decisionStateRefs    DecisionStateReference[]
  creativeFeatureSets  CreativeFeatureSet[]
  creativePatterns     CreativePattern[]
  processTransitionStats ProcessTransitionStat[]
  automationOpportunities AutomationOpportunity[]
  counterfactualRuns   CounterfactualRun[]
  // Conversation Revenue Engine
  contactSuppressions  ContactSuppression[]
  conversationUnderstandings ConversationUnderstanding[]
  outboundDispatches   OutboundDispatch[]
  conversationSendLeases ConversationSendLease[]
  // Social Prospecting + Outreach OS
  ayrshareProfiles     AyrshareProfile[]
  zernioProfiles       ZernioProfile[]
  socialProspects      SocialProspect[]
  socialOutreachThreads SocialOutreachThread[]
  socialProviderUsages  SocialProviderUsage[]
  socialMetricFacts    SocialMetricFact[]
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String?
  image                String?
  emailVerified        DateTime?
  mustChangePassword   Boolean   @default(false)
  isActive             Boolean   @default(true)
  isSuspended          Boolean   @default(false)
  isPlatformAdmin      Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  /// Last workspace the user explicitly used (login default / switcher).
  activeOrganisationId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  accounts              Account[]
  sessions              Session[]
  memberships           OrganisationMember[]
  invitationsSent       OrganisationInvitation[] @relation("InvitationInviter")
  assignedConversations ConversationAssignment[]
  notes                 Note[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  agentRuns             AgentRun[]
  assetsCreated         Asset[]

  @@index([activeOrganisationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OrganisationMember {
  id             String     @id @default(cuid())
  organisationId String
  userId         String
  role           MemberRole @default(SALES_AGENT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

model OrganisationInvitation {
  id             String           @id @default(cuid())
  organisationId String
  email          String
  role           MemberRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organisationId, email, status])
  @@index([organisationId, status])
  @@index([email])
}

model Integration {
  id             String          @id @default(cuid())
  organisationId String
  type           IntegrationType
  name           String
  isActive       Boolean         @default(false)
  config         Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  credentials  IntegrationCredential[]

  @@unique([organisationId, type, name])
  @@index([organisationId, type])
}

model IntegrationCredential {
  id             String    @id @default(cuid())
  integrationId  String
  keyName        String
  encryptedValue String    @db.Text
  /// UNKNOWN | HEALTHY | EXPIRED | REVOKED | ERROR
  healthStatus   String    @default("UNKNOWN")
  healthNote     String?
  lastVerifiedAt DateTime?
  /// Operator-recorded rotation time — never auto-rewrites ciphertext.
  lastRotatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, keyName])
}

/// Short-lived OAuth `state` nonce ledger — single-use CSRF binding for Meta Instagram Login.
model OAuthStateConsumption {
  nonce          String   @id
  organisationId String
  purpose        String
  userId         String?
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([organisationId, purpose])
  @@index([expiresAt])
}

model MessagingChannel {
  id             String   @id @default(cuid())
  organisationId String
  provider       String   @default("manychat")
  externalId     String?
  displayName    String
  instagramUsername String?
  isActive       Boolean  @default(true)
  config         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  conversations Conversation[]

  @@unique([organisationId, provider, externalId])
  @@index([organisationId])
}

/// A tenant's own OAuth-connected social account (Instagram/LinkedIn/TikTok).
/// Separate from MessagingChannel:
/// - SocialConnection powers listen/publish OAuth in Integrations → Social Connections
/// - MessagingChannel.provider = "meta_instagram" | "manychat" powers Instagram DMs
/// Native Meta Instagram DMs use IntegrationType.META_INSTAGRAM + MessagingChannel,
/// not ManyChat Integration rows. See docs/SOCIAL_CONNECTIONS.md.
model SocialConnection {
  id                String                 @id @default(cuid())
  organisationId    String
  platform          SocialPlatform
  externalAccountId String
  displayName       String?
  status            SocialConnectionStatus @default(PENDING)
  scopes            String[]               @default([])
  capabilities      Json                   @default("{}")
  connectedByUserId String?
  expiresAt         DateTime?
  lastSyncedAt      DateTime?
  metadata          Json                   @default("{}")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organisation Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  credentials  SocialConnectionCredential[]

  @@unique([organisationId, platform, externalAccountId])
  @@index([organisationId])
}

model SocialConnectionCredential {
  id                 String    @id @default(cuid())
  socialConnectionId String
  keyName            String
  encryptedValue     String    @db.Text
  /// UNKNOWN | HEALTHY | EXPIRED | REVOKED | ERROR
  healthStatus       String    @default("UNKNOWN")
  healthNote         String?
  lastVerifiedAt     DateTime?
  lastRotatedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  socialConnection SocialConnection @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)

  @@unique([socialConnectionId, keyName])
}

// ─── Phase 7 — Universal CRM + Revenue ──────────────────────────────────────

enum DealStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

/// Account / company — coexists with Contact + Lead.
model Company {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  domain         String?
  website        String?
  industry       String?
  sizeBand       String?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  activities   CrmActivity[]

  @@unique([organisationId, name])
  @@index([organisationId, domain])
  @@index([organisationId, updatedAt])
}

/// Revenue opportunity / deal — coexists with Lead (optional leadId link).
model Deal {
  id             String     @id @default(cuid())
  organisationId String
  companyId      String?
  contactId      String?
  leadId         String?
  name           String
  amountCents    Int?
  currency       String     @default("USD")
  status         DealStatus @default(OPEN)
  /// 0–1 win probability (explicit; null = unknown).
  probability    Float?
  stageLabel     String?
  expectedCloseAt DateTime?
  closedAt       DateTime?
  summary        String?    @db.Text
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities   CrmActivity[]
  attributions Attribution[]

  @@index([organisationId, status, updatedAt])
  @@index([organisationId, companyId])
  @@index([organisationId, contactId])
  @@index([organisationId, leadId])
}

/// Task / meeting / call / email activity — evidence-based CRM timeline.
model CrmActivity {
  id              String    @id @default(cuid())
  organisationId  String
  contactId       String?
  companyId       String?
  dealId          String?
  leadId          String?
  /// note | task | meeting | call | email | other
  kind            String
  title           String
  body            String?   @db.Text
  dueAt           DateTime?
  completedAt     DateTime?
  createdByUserId String?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, contactId, createdAt])
  @@index([organisationId, dealId, createdAt])
  @@index([organisationId, dueAt])
}

model Contact {
  id               String    @id @default(cuid())
  organisationId   String
  companyId        String?
  messagingChannelId String?
  fullName         String?
  instagramUsername String?
  email            String?
  phone            String?
  location         String?
  timezone         String?
  leadSource       String?
  campaignSource   String?
  firstContactAt   DateTime  @default(now())
  lastContactAt    DateTime  @default(now())
  optedOut         Boolean   @default(false)
  optedOutAt       DateTime?
  consentGiven     Boolean   @default(true)
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organisation     Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  company          Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  messagingChannel MessagingChannel?  @relation(fields: [messagingChannelId], references: [id])
  identifiers      ContactIdentifier[]
  conversations    Conversation[]
  leads            Lead[]
  deals            Deal[]
  crmActivities    CrmActivity[]
  tags             ContactTag[]
  notes            Note[]
  bookings         Booking[]
  followUps        FollowUp[]
  attributions     Attribution[]
  suppressions     ContactSuppression[]
  socialProspects  SocialProspect[]
  socialOutreachThreads SocialOutreachThread[]

  @@index([organisationId, lastContactAt])
  @@index([organisationId, email])
  @@index([organisationId, phone])
  @@index([organisationId, instagramUsername])
  @@index([organisationId, companyId])
}

model ContactIdentifier {
  id             String   @id @default(cuid())
  organisationId String
  contactId      String
  channel        String
  identifier     String
  createdAt      DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organisationId, channel, identifier])
  @@index([contactId])
}

model Conversation {
  id                             String       @id @default(cuid())
  organisationId                 String
  contactId                      String
  messagingChannelId             String?
  externalThreadId               String?
  subject                        String?
  handlingMode                   HandlingMode @default(AI)
  unreadCount                    Int          @default(0)
  lastMessageAt                  DateTime?
  lastMessagePreview             String?
  lastInboundAt                  DateTime?
  lastOutboundAt                 DateTime?
  messagingWindowExpiresAt       DateTime?
  humanMessagingWindowExpiresAt  DateTime?
  handoffReason                  String?
  aiPaused                       Boolean      @default(false)
  needsHumanReview               Boolean      @default(false)
  summary                        String?      @db.Text
  intent                         String?
  sentiment                      String?
  /// Monotonic activity version — bumped on material inbound/outbound/human actions.
  activityVersion                Int          @default(0)
  /// Transparent priority class (HOT_LEAD | REPLY_NEEDED | …) — not a fake 0–100 score.
  priorityClass                  String?
  closedAt                       DateTime?
  closedReason                   String?
  handoffPacket                  Json?
  metadata                       Json         @default("{}")
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  deletedAt                      DateTime?

  organisation     Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact          Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messagingChannel MessagingChannel?        @relation(fields: [messagingChannelId], references: [id])
  messages         Message[]
  leads            Lead[]
  assignments      ConversationAssignment[]
  notes            Note[]
  bookings         Booking[]
  followUps        FollowUp[]
  objections       Objection[]
  questions        DetectedQuestion[]
  buyingSignals    BuyingSignal[]
  insights         ConversationInsight[]
  tags             ConversationTag[]
  understandings   ConversationUnderstanding[]
  outboundDispatches OutboundDispatch[]
  sendLease        ConversationSendLease?

  @@unique([organisationId, externalThreadId])
  @@index([organisationId, lastMessageAt])
  @@index([organisationId, needsHumanReview])
  @@index([organisationId, priorityClass])
  @@index([contactId])
}

model ConversationAssignment {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  assignedAt     DateTime @default(now())
  active         Boolean  @default(true)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, active])
  @@index([userId])
}

model Message {
  id               String             @id @default(cuid())
  conversationId   String
  organisationId   String
  externalId       String?
  direction        MessageDirection
  senderType       MessageSenderType
  body             String             @db.Text
  /// Provenance: "simulator", "manychat", "integration_test", etc. Null for legacy rows.
  origin           String?
  rawPayload       Json?
  aiMetadata       Json?
  deliveryStatus   String?
  /// Provider-backed only — never invent from local API success.
  deliveredAt      DateTime?
  readAt           DateTime?
  failureCode      String?
  providerError    String?
  inReplyToMessageId String?
  agentVersion     String?
  sentAt           DateTime           @default(now())
  createdAt        DateTime           @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  outboundDispatches OutboundDispatch[]

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
  @@index([organisationId, sentAt])
  @@index([organisationId, origin])
  @@index([organisationId, conversationId, sentAt])
}

model Pipeline {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  leads        Lead[]

  @@unique([organisationId, name])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  slug       String
  position   Int
  color      String   @default("#64748b")
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, slug])
  @@index([pipelineId, position])
}

model Lead {
  id                   String              @id @default(cuid())
  organisationId       String
  contactId            String
  conversationId       String?
  pipelineId           String?
  stageId              String?
  qualificationStatus  QualificationStatus @default(UNKNOWN)
  score                Int                 @default(0)
