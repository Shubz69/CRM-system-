  @@index([organisationId, createdAt])
  @@index([provider, model, createdAt])
  @@index([taskType, createdAt])
  @@index([success, createdAt])
}

/// Per-organisation AI spend cap (cents). Null monthlyCapCents = unlimited.
/// Period spend is computed from AiExecution — this table is the gate config only.
model OrganisationAiBudget {
  id              String   @id @default(cuid())
  organisationId  String   @unique
  /// Monthly cap in USD cents. null = no cap (existing behaviour).
  monthlyCapCents Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

enum AgentRunStatus {
  PENDING
  PLANNING
  AWAITING_CLARIFICATION
  /// Imaging: derived prompt shown for edit/confirm before generation spend.
  AWAITING_PROMPT_CONFIRM
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// How much AgentStep.input/output is retained after age thresholds.
enum AgentDetailRetention {
  FULL
  COMPACT
  SKELETON
}

/// AgentRun.partialResults retention (finalOutput is never pruned).
enum PartialResultsRetention {
  FULL
  SUMMARY
}

/// Per-org hard limits for multi-agent runs.
model OrganisationAgentLimits {
  id                   String   @id @default(cuid())
  organisationId       String   @unique
  maxSteps             Int      @default(8)
  maxWallClockSeconds  Int      @default(600)
  /// Cap for a single run in cents. null = use monthly spend gate only.
  maxSpendCentsPerRun  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

/// Per-org agent artifact retention windows (days). Sensible defaults match product policy.
model OrganisationAgentRetention {
  id                     String   @id @default(cuid())
  organisationId         String   @unique
  /// ToolCall.args / result cleared after this many days (debug-only blobs).
  toolCallPayloadDays    Int      @default(14)
  /// AgentStep input/output kept full, then compact preview.
  stepFullDetailDays     Int      @default(30)
  /// After this age, steps are label/status/cost skeleton only.
  stepSkeletonAfterDays  Int      @default(180)
  /// AgentRun.partialResults full, then collapsed to a short summary.
  partialResultsFullDays Int      @default(30)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id                      String                  @id @default(cuid())
  organisationId          String
  /// Optional parent Mission — AgentRun remains the execution trace (not duplicated as Mission).
  missionId               String?
  missionTaskId           String?
  /// Null when triggered by system/schedule (recurring runs later).
  userId                  String?
  /// user | system | schedule
  triggeredBy             String                  @default("user")
  request                 String                  @db.Text
  plan                    Json?
  plainEnglishPlan        String?                 @db.Text
  clarificationQuestion   String?                 @db.Text
  clarificationOptions    Json?
  status                  AgentRunStatus          @default(PENDING)
  /// Optional answer mode for Ask/agent runs (nullable for back-compat).
  answerMode              AgentAnswerMode?
  startedAt               DateTime?
  finishedAt              DateTime?
  totalCostCents          Int                     @default(0)
  error                   String?                 @db.Text
  userFacingError         String?                 @db.Text
  partialResults          Json?
  partialResultsRetention PartialResultsRetention @default(FULL)
  /// First-class output artifact for later save/share/export. Kept indefinitely.
  finalOutput             Json?
  /// Imaging: proposed generation prompt awaiting user edit/confirm.
  pendingPrompt           String?                 @db.Text
  pendingBrief            Json?
  pendingCostEstimateCents Int?
  referenceAssetId        String?
  maxSteps                Int                     @default(8)
  maxWallClockSeconds     Int                     @default(600)
  maxSpendCents           Int?
  bullJobId               String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  referenceAsset Asset?       @relation("AgentRunReferenceAsset", fields: [referenceAssetId], references: [id], onDelete: SetNull)
  mission        AgentMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  missionTask    MissionTask?  @relation(fields: [missionTaskId], references: [id], onDelete: SetNull)
  steps          AgentStep[]
  memoryEpisodes MemoryEpisode[]

  @@index([organisationId, createdAt])
  @@index([organisationId, status])
  @@index([organisationId, partialResultsRetention, createdAt])
  @@index([bullJobId])
  @@index([referenceAssetId])
  @@index([missionId])
  @@index([missionTaskId])
}

model AgentStep {
  id               String               @id @default(cuid())
  organisationId   String
  agentRunId       String
  position         Int
  agentName        String
  /// Plain-English label shown to users. Never empty.
  userFacingLabel  String
  input            Json
  output           Json?
  model            String?
  tokensIn         Int?
  tokensOut        Int?
  costCents        Int                  @default(0)
  durationMs       Int?
  status           AgentStepStatus      @default(PENDING)
  userFacingStatus String?
  detailRetention  AgentDetailRetention @default(FULL)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  toolCalls    ToolCall[]

  @@index([organisationId, agentRunId])
  @@index([organisationId, createdAt])
  @@index([organisationId, detailRetention, createdAt])
  @@index([agentRunId, position])
}

model ToolCall {
  id               String    @id @default(cuid())
  organisationId   String
  agentStepId      String
  toolName         String
  args             Json      @default("{}")
  result           Json?
  durationMs       Int?
  error            String?   @db.Text
  /// Set when args/result payloads were cleared by retention.
  payloadClearedAt DateTime?
  createdAt        DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agentStep    AgentStep    @relation(fields: [agentStepId], references: [id], onDelete: Cascade)

  @@index([organisationId, agentStepId])
  @@index([organisationId, payloadClearedAt, createdAt])
  @@index([agentStepId, createdAt])
}

// ─── Phase 12 — Durable Mission runtime ─────────────────────────────────────
// Hierarchy: Organisation → (Goal later) → Mission → Task DAG → AgentRun → Step → ToolCall
// Never persist private chain-of-thought — only plan summaries, evidence, decisions, outcomes.
// Mutations use transactions so Phase 12B outbox rows can attach atomically.

enum MissionStatus {
  QUEUED
  PLANNING
  RUNNING
  WAITING
  WAITING_APPROVAL
  BLOCKED
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum MissionTaskStatus {
  PENDING
  READY
  RUNNING
  WAITING
  WAITING_APPROVAL
  BLOCKED
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

enum MissionErrorClass {
  NONE
  TRANSIENT
  RATE_LIMIT
  TIMEOUT
  TOOL_FAILED
  PROVIDER_OUTAGE
  OAUTH_EXPIRED
  BUDGET
  PERMISSION
  VALIDATION
  DEPENDENCY
  CANCELLED
  UNKNOWN
}

/// External consequential action outcome — prevents blind replay after crash (publish/DM/email/calendar later).
enum MissionExternalOutcome {
  NOT_STARTED
  PREPARED
  DISPATCHING
  CONFIRMED
  FAILED
  RECONCILIATION_REQUIRED
}

/// Durable multi-step mission. Survives worker restart / Redis loss (state in Postgres).
model AgentMission {
  id                 String        @id @default(cuid())
  organisationId     String
  /// Optional Goal link (Phase 13).
  goalId             String?
  /// Optional BusinessOpportunity that spawned this mission.
  businessOpportunityId String?
  createdByUserId    String?
  title              String
  /// Operational objective summary — not private reasoning.
  objectiveSummary   String        @db.Text
  status             MissionStatus @default(QUEUED)
  priority           Int           @default(100)
  planSummary        String?       @db.Text
  budgetCents        Int?
  spentCents         Int           @default(0)
  deadlineAt         DateTime?
  /// Opaque cursor for resume after crash (task id + attempt).
  resumeCursor       Json?
  lastErrorClass     MissionErrorClass @default(NONE)
  lastErrorMessage   String?       @db.Text
  /// Decision summary only — never chain-of-thought.
  decisionSummary    String?       @db.Text
  /// Optional link to Phase 20 Decision ledger (choice ≠ execution authority).
  decisionId         String?
  confidence         Float?
  startedAt          DateTime?
  finishedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  goal                 Goal?                 @relation(fields: [goalId], references: [id], onDelete: SetNull)
  businessOpportunity  BusinessOpportunity?  @relation(fields: [businessOpportunityId], references: [id], onDelete: SetNull)
  ledgerDecision       Decision?             @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  tasks                MissionTask[]
  checkpoints          MissionCheckpoint[]
  artifacts            MissionArtifact[]
  outcomes             MissionOutcome[]
  agentRuns            AgentRun[]

  @@index([organisationId, status, createdAt])
  @@index([organisationId, deadlineAt])
  @@index([goalId])
  @@index([businessOpportunityId])
  @@index([decisionId])
}

model MissionTask {
  id                 String            @id @default(cuid())
  organisationId     String
  missionId          String
  /// Stable key within mission for idempotent retries.
  idempotencyKey     String
  title              String
  description        String?           @db.Text
  status             MissionTaskStatus @default(PENDING)
  priority           Int               @default(100)
  attempt            Int               @default(0)
  maxAttempts        Int               @default(3)
  timeoutMs          Int               @default(300000)
  deadlineAt         DateTime?
  budgetCents        Int?
  spentCents         Int               @default(0)
  assignedAgent      String?
  assignedAgentVersion String?
  checkpointRef      String?
  /// Consequential side-effect state — CONFIRMED must not be blindly replayed after crash.
  externalOutcome    MissionExternalOutcome @default(NOT_STARTED)
  /// Approver identity when task entered WAITING_APPROVAL / was decided.
  approvalUserId     String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?           @db.Text
  errorClass         MissionErrorClass @default(NONE)
  lastError          String?           @db.Text
  /// Operational result summary — not private reasoning.
  resultSummary      String?           @db.Text
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  mission      AgentMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  dependsOn    MissionTaskDependency[] @relation("TaskDependsOn")
  dependedBy   MissionTaskDependency[] @relation("TaskDependedBy")
  agentRuns    AgentRun[]

  @@unique([missionId, idempotencyKey])
  @@index([organisationId, missionId, status])
  @@index([organisationId, status, priority])
}

/// DAG edge: taskId cannot start until dependsOnTaskId is COMPLETED.
model MissionTaskDependency {
  id               String   @id @default(cuid())
  organisationId   String
  missionId        String
  taskId           String
  dependsOnTaskId  String
  createdAt        DateTime @default(now())

  task        MissionTask @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   MissionTask @relation("TaskDependedBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([missionId])
  @@index([organisationId, missionId])
}

model MissionCheckpoint {
  id             String   @id @default(cuid())
  organisationId String
  missionId      String
  taskId         String?
  /// Opaque resume payload (task ids, attempt, evidence refs) — not chain-of-thought.
  payload        Json
  label          String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  mission      AgentMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([organisationId, missionId, createdAt])
}

model MissionArtifact {
  id             String   @id @default(cuid())
  organisationId String
  missionId      String
  taskId         String?
  kind           String
  /// URI or storage key — content may be untrusted; treat as data.
  uri            String?
  /// Redacted metadata / citations / evidence refs only.
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  mission      AgentMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([organisationId, missionId])
}

model MissionOutcome {
  id               String   @id @default(cuid())
  organisationId   String
  missionId        String
  /// success | partial | failed | cancelled
  kind             String
  summary          String   @db.Text
  confidence       Float?
  evaluationNotes  String?  @db.Text
  metrics          Json     @default("{}")
  createdAt        DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  mission      AgentMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([organisationId, missionId])
}

// ─── Phase 12B — Transactional domain event outbox ───────────────────────────

enum DomainEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  RETRY
  DEAD_LETTER
  CANCELLED
}

enum DomainEventConsumptionStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

/// Durable outbox row — inserted in the same Postgres transaction as the business mutation.
model DomainEvent {
  id               String            @id @default(cuid())
  organisationId   String
  eventType        String
  eventVersion     Int               @default(1)
  aggregateType    String
  aggregateId      String
  /// Immutable business payload (IDs + stable values only — never secrets).
  payload          Json
  metadata         Json              @default("{}")
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  availableAt      DateTime          @default(now())
  status           DomainEventStatus @default(PENDING)
  attemptCount     Int               @default(0)
  maxAttempts      Int               @default(8)
  lockedAt         DateTime?
  lockOwner        String?
  processedAt      DateTime?
  lastError        String?           @db.Text
  errorClass       String?
  firstFailedAt    DateTime?
  lastFailedAt     DateTime?
  correlationId    String?
  causationId      String?
  actorType        String?
  actorId          String?
  /// Optional idempotent emit key (unique per org when set).
  dedupeKey        String?
  /// Per-aggregate ordering within organisation.
  aggregateSequence Int              @default(0)

  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  consumptions DomainEventConsumption[]

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, status, availableAt])
  @@index([organisationId, aggregateType, aggregateId, aggregateSequence])
  @@index([organisationId, correlationId])
  @@index([status, availableAt])
  @@index([eventType, createdAt])
}

/// Per-consumer processing record — fan-out with independent idempotency.
model DomainEventConsumption {
  id               String                       @id @default(cuid())
  organisationId   String
  eventId          String
  consumer         String
  status           DomainEventConsumptionStatus @default(PENDING)
  processedAt      DateTime?
  resultReference  String?
  lastError        String?                      @db.Text
  attemptCount     Int                          @default(0)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        DomainEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumer])
  @@index([organisationId, consumer, status])
  @@index([organisationId, createdAt])
}

enum ResearchJobKind {
  RESEARCH
  SOCIAL_LISTENING
}

enum ResearchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

/// Org-scoped research / social-listening run (paired with AgentRun when started from Ask).
model ResearchJob {
  id              String            @id @default(cuid())
  organisationId  String
  agentRunId      String?
  kind            ResearchJobKind
  topic           String            @db.Text
  status          ResearchJobStatus @default(PENDING)
  /// Expanded search queries used for this job.
  queries         Json              @default("[]")
  /// Analyst brief (claims must cite source URLs).
  brief           Json?
  contradictions  Json?
  gaps            Json?
  criticReport    Json?
  totalCostCents  Int               @default(0)
  error           String?           @db.Text
  userFacingError String?           @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sources      ResearchSource[]
  findings     ResearchFinding[]
  snapshots    ResearchSourceSnapshot[]
  socialPosts  SocialPost[]
  trendSignals TrendSignal[]

  @@index([organisationId, createdAt])
  @@index([organisationId, status])
  @@index([organisationId, kind, createdAt])
  @@index([agentRunId])
}

enum ResearchClaimKind {
  OFFICIAL
  OBSERVATION
  INFERENCE
  SECONDARY
  UNKNOWN
}

model ResearchSource {
  id             String    @id @default(cuid())
  organisationId String
  researchJobId  String
  url            String
  title          String?
  platform       String
  author         String?
  publishedAt    DateTime?
  /// When this row was fetched from the provider (not when the page was published).
  retrievedAt    DateTime  @default(now())
  content        String?   @db.Text
  /// SHA-256 hex of normalised content for dedupe / integrity.
  contentHash    String?
  /// 0–1 score from publishedAt age at retrieval time (null if unknown).
  freshnessScore Float?
  engagement     Json?
  rawMetadata    Json      @default("{}")
  queryUsed      String?
  createdAt      DateTime  @default(now())

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob  ResearchJob             @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  findings     ResearchFinding[]
  snapshot     ResearchSourceSnapshot?
  socialPosts  SocialPost[]

  @@unique([researchJobId, url])
  @@index([organisationId, researchJobId])
  @@index([organisationId, platform, createdAt])
  @@index([organisationId, contentHash])
}

/// Immutable capture of source content at retrieval time (Evidence Fabric).
model ResearchSourceSnapshot {
  id               String   @id @default(cuid())
  organisationId   String
  researchJobId    String
  researchSourceId String   @unique
  url              String
  title            String?
  platform         String
  author           String?
  publishedAt      DateTime?
  retrievedAt      DateTime
  content          String?  @db.Text
  contentHash      String?
  engagement       Json?
  rawMetadata      Json     @default("{}")
  createdAt        DateTime @default(now())

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob    ResearchJob   @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  researchSource ResearchSource @relation(fields: [researchSourceId], references: [id], onDelete: Cascade)

  @@index([organisationId, researchJobId])
  @@index([organisationId, contentHash])
  @@index([organisationId, retrievedAt])
}

/// A claim grounded in exactly one source URL (via ResearchSource).
model ResearchFinding {
  id                  String            @id @default(cuid())
  organisationId      String
  researchJobId       String
  researchSourceId    String
  claim               String            @db.Text
  evidenceExcerpt     String?           @db.Text
  confidence          Float?
  claimKind           ResearchClaimKind @default(UNKNOWN)
  /// Inherited / computed from source freshness at write time.
  freshnessScore      Float?
  verifiedByCritic    Boolean           @default(false)
  flaggedUnsupported  Boolean           @default(false)
  /// Critic: excerpt/claim not found in source body (URL may still be valid).
  flaggedUngrounded   Boolean           @default(false)
  createdAt           DateTime          @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob  ResearchJob   @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  source       ResearchSource @relation(fields: [researchSourceId], references: [id], onDelete: Cascade)

  @@index([organisationId, researchJobId])
  @@index([organisationId, researchSourceId])
  @@index([organisationId, claimKind])
}

model SocialPost {
  id                  String    @id @default(cuid())
  organisationId      String
  researchJobId       String
  researchSourceId    String?
  platform            String
  url                 String
  title               String?
  author              String?
  publishedAt         DateTime?
  content             String?   @db.Text
  engagement          Json?
  extractedThemes     Json      @default("[]")
  extractedHooks      Json      @default("[]")
  extractedFormats    Json      @default("[]")
  extractedQuestions  Json      @default("[]")
  extractedComplaints Json      @default("[]")
  createdAt           DateTime  @default(now())

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob  ResearchJob    @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  source       ResearchSource? @relation(fields: [researchSourceId], references: [id], onDelete: SetNull)

  @@unique([researchJobId, url])
  @@index([organisationId, researchJobId])
  @@index([organisationId, platform, createdAt])
}

model TrendSignal {
  id             String   @id @default(cuid())
  organisationId String
  researchJobId  String
  /// theme | hook | format | question | complaint
  signalType     String
  label          String
  frequency      Int      @default(1)
  evidenceUrls   String[] @default([])
  summary        String?  @db.Text
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchJob  ResearchJob  @relation(fields: [researchJobId], references: [id], onDelete: Cascade)

  @@index([organisationId, researchJobId])
  @@index([organisationId, signalType, frequency])
}

/// Canonical creator identity across research / social listening (Phase 4).
model SocialCreator {
  id             String   @id @default(cuid())
  organisationId String
  platform       String
  /// Normalised handle / channel id (lowercase, no leading @).
  handle         String
  displayName    String?
  profileUrl     String?
  externalId     String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contents     SocialContent[]

  @@unique([organisationId, platform, handle])
  @@index([organisationId, platform])
}

/// Canonical social post/video — one row per org+platform+url. Metrics live in snapshots.
model SocialContent {
  id               String    @id @default(cuid())
  organisationId   String
  platform         String
  url              String
  externalId       String?
  creatorId        String?
  title            String?
  body             String?   @db.Text
  publishedAt      DateTime?
  /// short | reel | video | post | thread | carousel | other
  format           String?
  topics           String[]  @default([])
  researchSourceId String?
  socialPostId     String?
  rawMetadata      Json      @default("{}")
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  creator      SocialCreator?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  metrics      SocialMetricSnapshot[]

  @@unique([organisationId, platform, url])
  @@index([organisationId, platform, publishedAt])
  @@index([organisationId, creatorId])
  @@index([organisationId, lastSeenAt])
  @@index([organisationId, format])
}

/// Time-series engagement — never overwrite; append snapshots.
model SocialMetricSnapshot {
  id              String   @id @default(cuid())
  organisationId  String
  socialContentId String
  capturedAt      DateTime @default(now())
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  score           Float?
  raw             Json     @default("{}")
  createdAt       DateTime @default(now())

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  socialContent SocialContent @relation(fields: [socialContentId], references: [id], onDelete: Cascade)

  @@index([organisationId, socialContentId, capturedAt])
  @@index([organisationId, capturedAt])
  @@index([socialContentId, capturedAt])
}

// ─── Phase 5 — Trend & Algorithm Intelligence ───────────────────────────────

enum TrendLifecycleState {
  EMERGING
  ACCELERATING
  BREAKOUT
  MAINSTREAM
  SATURATED
  DECLINING
  RECURRING
}

enum AlgorithmEvidenceKind {
  OFFICIAL
  OBSERVATIONAL
  UNKNOWN
}

enum TrendForecastHorizon {
  H24
  D3
  D7
  D30
}

/// Aggregated trend cluster with lifecycle state (features drive state; LLM interprets later).
model TrendCluster {
  id             String              @id @default(cuid())
  organisationId String
  /// Normalised label key (lowercase slug-ish).
  key            String
  label          String
  /// theme | hook | format | topic | other
  kind           String              @default("theme")
  state          TrendLifecycleState @default(EMERGING)
  platforms      String[]            @default([])
  evidenceUrls   String[]            @default([])
  /// Latest feature vector summary (velocity, acceleration, crossPlatformCount, …).
  features       Json                @default("{}")
  firstSeenAt    DateTime            @default(now())
  lastSeenAt     DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  featureSnaps TrendFeatureSnapshot[]
  forecasts    TrendForecast[]

  @@unique([organisationId, key])
  @@index([organisationId, state, lastSeenAt])
  @@index([organisationId, kind, lastSeenAt])
}

model TrendFeatureSnapshot {
  id             String   @id @default(cuid())
  organisationId String
  trendClusterId String
  /// 24h | 3d | 7d | 30d
  window         String
  capturedAt     DateTime @default(now())
  mentionCount   Int      @default(0)
  contentCount   Int      @default(0)
  velocity       Float    @default(0)
  acceleration   Float    @default(0)
  crossPlatformCount Int  @default(0)
  engagementScore Float   @default(0)
  features       Json     @default("{}")
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trendCluster TrendCluster @relation(fields: [trendClusterId], references: [id], onDelete: Cascade)

  @@index([organisationId, trendClusterId, capturedAt])
  @@index([organisationId, window, capturedAt])
}

/// Documented or observed platform algorithm changes — never invent official status.
model AlgorithmChange {
  id               String                @id @default(cuid())
  organisationId   String
  platform         String
  /// e.g. reels_fyp | youtube_shorts | linkedin_feed
  surface          String?
  changeType       String
  title            String
  summary          String?               @db.Text
  evidenceKind     AlgorithmEvidenceKind @default(UNKNOWN)
  confidence       Float?
  detectedAt       DateTime              @default(now())
  effectiveAt      DateTime?
  sourceUrl        String?
  affectedFormats  String[]              @default([])
  expectedImpact   String?               @db.Text
  recommendedExperiment String?           @db.Text
  validationNotes  String?               @db.Text
  metadata         Json                  @default("{}")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, platform, detectedAt])
  @@index([organisationId, evidenceKind, detectedAt])
}

/// Probabilistic forecast with explicit uncertainty — no certainty theatre.
model TrendForecast {
  id               String              @id @default(cuid())
  organisationId   String
  trendClusterId   String
  horizon          TrendForecastHorizon
  /// Probability the trend remains accelerating / breakout in this horizon (0–1).
  probability      Float
  /// Half-width uncertainty band around probability (0–0.5 typical).
  uncertainty      Float
  drivers          String[]            @default([])
  counterSignals   String[]            @default([])
  featureSnapshotId String?
  /// low | medium | high — qualitative only
  confidenceLabel  String?
  createdAt        DateTime            @default(now())
  /// When this forecast becomes evaluable.
  resolveAfter     DateTime

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trendCluster TrendCluster          @relation(fields: [trendClusterId], references: [id], onDelete: Cascade)
  outcome      TrendForecastOutcome?

  @@index([organisationId, trendClusterId, createdAt])
  @@index([organisationId, resolveAfter])
  @@index([organisationId, horizon, createdAt])
}

/// Real outcome for backtesting — metrics only when rows exist.
model TrendForecastOutcome {
  id              String   @id @default(cuid())
  organisationId  String
  trendForecastId String   @unique
  /// Whether the predicted state direction held.
  realizedPositive Boolean
  realizedState   TrendLifecycleState?
  notes           String?  @db.Text
  evaluatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trendForecast TrendForecast @relation(fields: [trendForecastId], references: [id], onDelete: Cascade)

  @@index([organisationId, evaluatedAt])
}

// ─── Phase 6 — Content Operating System ─────────────────────────────────────

enum ContentOpportunityStatus {
  OPEN
  ACCEPTED
  DISMISSED
  EXPIRED
}

enum ContentPieceStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum PublishingJobStatus {
  PENDING_APPROVAL
  APPROVED
  QUEUED
  SCHEDULED
  DISPATCHING
  PUBLISHING
  PUBLISHED
  FAILED
  RECONCILIATION_REQUIRED
  CANCELLED
}

/// Research/trend-backed opportunity — must carry “why” evidence.
model ContentOpportunity {
  id               String                   @id @default(cuid())
  organisationId   String
  title            String
  summary          String?                  @db.Text
  status           ContentOpportunityStatus @default(OPEN)
  /// Platforms this opportunity targets.
  platforms        String[]                 @default([])
  /// Structured why: { researchJobId?, trendClusterId?, sourceUrls[], claimIds[], rationale }
  whyEvidence      Json                     @default("{}")
  researchJobId    String?
  trendClusterId   String?
  agentRunId       String?
  score            Float?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  expiresAt        DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ideas        ContentIdea[]

  @@index([organisationId, status, createdAt])
  @@index([organisationId, researchJobId])
  @@index([organisationId, trendClusterId])
}

model ContentIdea {
  id             String   @id @default(cuid())
  organisationId String
  opportunityId  String?
  title          String
  angle          String?  @db.Text
  hook           String?  @db.Text
  formatHint     String?
  /// Copy of opportunity whyEvidence + extra links
  whyEvidence    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunity  ContentOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  briefs       CreativeBrief[]

  @@index([organisationId, createdAt])
  @@index([organisationId, opportunityId])
}

model CreativeBrief {
  id             String   @id @default(cuid())
  organisationId String
  ideaId         String
  objective      String?  @db.Text
  audience       String?  @db.Text
  keyMessage     String?  @db.Text
  cta            String?
  constraints    String?  @db.Text
  whyEvidence    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  idea         ContentIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  pieces       ContentPiece[]

  @@index([organisationId, ideaId])
}

model ContentPiece {
  id             String            @id @default(cuid())
  organisationId String
  briefId        String?
  title          String
  body           String            @db.Text
  status         ContentPieceStatus @default(DRAFT)
  platform       String?
  whyEvidence    Json              @default("{}")
  assetId        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        CreativeBrief?   @relation(fields: [briefId], references: [id], onDelete: SetNull)
  versions     ContentVersion[]
  variants     ContentVariant[]
  approvals    ContentApproval[]
  publishingJobs PublishingJob[]
  performances PostPerformance[]

  @@index([organisationId, status, createdAt])
  @@index([organisationId, briefId])
}

model ContentVersion {
  id             String   @id @default(cuid())
  organisationId String
  pieceId        String
  version        Int
  title          String?
  body           String   @db.Text
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  piece        ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@unique([pieceId, version])
  @@index([organisationId, pieceId])
}

model ContentVariant {
  id             String   @id @default(cuid())
  organisationId String
  pieceId        String
  platform       String
  label          String?
  body           String   @db.Text
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  piece        ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([organisationId, pieceId, platform])
}

model ContentApproval {
  id             String   @id @default(cuid())
  organisationId String
  pieceId        String
  /// PENDING | APPROVED | REJECTED
  decision       String   @default("PENDING")
  decidedByUserId String?
  note           String?  @db.Text
  createdAt      DateTime @default(now())
  decidedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  piece        ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([organisationId, pieceId, createdAt])
  @@index([organisationId, decision])
}

/// Publish only via approved connected APIs — never invent a successful publish.
model PublishingJob {
  id                 String              @id @default(cuid())
  organisationId     String
  pieceId            String
  variantId          String?
  platform           String
  status             PublishingJobStatus @default(PENDING_APPROVAL)
  /// SocialConnection id when publishing via OAuth.
  socialConnectionId String?
  scheduledAt        DateTime?
  publishedAt        DateTime?
  externalPostId     String?
  externalUrl        String?
  error              String?             @db.Text
  /// Policy decision snapshot { effect, reason, toolName }
  policySnapshot     Json                @default("{}")
  /// Phase 15 — external action ledger (aligns with MissionExternalOutcome).
  externalOutcome    MissionExternalOutcome @default(NOT_STARTED)
  attemptCount       Int                 @default(0)
  idempotencyKey     String?
  lastDispatchAt     DateTime?
  confirmedAt        DateTime?
  reconciliationNote String?             @db.Text
  missionId          String?
  approvalRequestId  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  piece        ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  performances PostPerformance[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, status, createdAt])
  @@index([organisationId, pieceId])
  @@index([organisationId, platform, status])
  @@index([organisationId, externalOutcome, status])
}

model PostPerformance {
  id               String   @id @default(cuid())
  organisationId   String
  pieceId          String?
  publishingJobId  String?
  socialContentId  String?
  capturedAt       DateTime @default(now())
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  clicks           Int?
  leadsAttributed  Int?
  raw              Json     @default("{}")
  createdAt        DateTime @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  piece         ContentPiece? @relation(fields: [pieceId], references: [id], onDelete: SetNull)
  publishingJob PublishingJob? @relation(fields: [publishingJobId], references: [id], onDelete: SetNull)

  @@index([organisationId, pieceId, capturedAt])
  @@index([organisationId, publishingJobId])
  @@index([organisationId, capturedAt])
}


/// Org-scoped media asset (reference uploads + generated images). Bytes live in object storage.
model Asset {
  id                 String   @id @default(cuid())
  organisationId     String
  /// Opaque object locator from storage (may be a private Blob URL).
  /// Never serve this to browsers as a public link — mint a signed/read-time URL instead.
  url                String
  /// Canonical org-scoped object key used for reads and provenance (`org/{organisationId}/…`).
  storageKey         String
  prompt             String?  @db.Text
  derivedFromAssetId String?
  provider           String?
  model              String?
  costCents          Int      @default(0)
  createdByUserId    String?
  width              Int?
  height             Int?
  mimeType           String
  /// reference | generated
  kind               String   @default("reference")
  createdAt          DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  derivedFrom  Asset?       @relation("AssetDerivations", fields: [derivedFromAssetId], references: [id], onDelete: SetNull)
  derivatives  Asset[]      @relation("AssetDerivations")
  agentRunsAsReference AgentRun[] @relation("AgentRunReferenceAsset")

  @@unique([organisationId, storageKey])
  @@index([organisationId, createdAt])
  @@index([organisationId, kind, createdAt])
  @@index([derivedFromAssetId])
  @@index([createdByUserId])
}

// ─── Memory V2 (episodic / entity / performance / preference) ───────────────

enum MemoryEntityFactStatus {
  CANDIDATE
  APPROVED
  REJECTED
}

/// Prior agent run / interaction summary. Auto-written; TTL via expiresAt.
model MemoryEpisode {
  id             String    @id @default(cuid())
  organisationId String
  agentRunId     String?
  /// ask | inbound | automation | other
  kind           String    @default("ask")
  summary        String    @db.Text
  requestPreview String?   @db.Text
  outcomeStatus  String?
  tags           String[]  @default([])
  metadata       Json      @default("{}")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, expiresAt])
  @@index([organisationId, kind, createdAt])
  @@index([agentRunId])
}

/// Fact about a contact, company, topic, or other entity. Provenance required.
model MemoryEntityFact {
  id             String                 @id @default(cuid())
  organisationId String
  /// contact | company | topic | other
  entityType     String
  /// Stable key (contact id, normalised name, slug).
  entityKey      String
  factKey        String
  factValue      String                 @db.Text
  confidence     Float                  @default(0.5)
  /// { sourceType, sourceId?, excerpt?, recordedAt }
  provenance     Json
  status         MemoryEntityFactStatus @default(CANDIDATE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, entityType, entityKey, factKey])
  @@index([organisationId, entityType, entityKey])
  @@index([organisationId, status, updatedAt])
}

/// Measured campaign / experiment / content outcomes (not estimates).
model MemoryPerformanceOutcome {
  id             String   @id @default(cuid())
  organisationId String
  /// campaign | experiment | content | ask_feedback | other
  kind           String
  subjectKey     String?
  metric         String
  value          Float
  unit           String?
  measuredAt     DateTime @default(now())
  /// Optional link to Campaign / Experiment / Asset id
  sourceRef      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, kind, measuredAt])
  @@index([organisationId, subjectKey, measuredAt])
  @@index([organisationId, sourceRef])
}

/// Admin / operator preferences (tone, operating style). Not auto-inferred as truth.
model OrganisationPreference {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  value          Json
  updatedByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, key])
  @@index([organisationId])
}

// ─── Phase 9 — Learning & Experimentation ───────────────────────────────────

enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

enum AgentVersionCandidateStatus {
  DRAFT
  EVALUATING
  PASSED
  FAILED
  PROMOTED
  REJECTED
}

enum EvalRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
}

/// Explicit human/system signal on a recommendation — never inferred as success.
model RecommendationFeedback {
  id             String   @id @default(cuid())
  organisationId String
  /// knowledge_recommendation | content_opportunity | insight | other
  subjectKind    String
  subjectId      String
  /// helpful | not_helpful | accepted | dismissed | outcome_positive | outcome_negative
  signal         String
  rating         Int?
  note           String?  @db.Text
  userId         String?
  outcomeMetric  String?
  /// Only set when a real measured value exists.
  outcomeValue   Float?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, subjectKind, createdAt])
  @@index([organisationId, subjectId, createdAt])
  @@index([organisationId, signal, createdAt])
}

/// A/B or multi-variant experiment. Results stay null until real measurements exist.
model Experiment {
  id              String           @id @default(cuid())
  organisationId  String
  name            String
  hypothesis      String           @db.Text
  status          ExperimentStatus @default(DRAFT)
  /// [{ key, label, description? }]
  variants        Json             @default("[]")
  primaryMetric   String
  /// { sampleSize, winnerKey?, metricByVariant?, message } — null metrics when sampleSize=0
  resultSummary   Json?
  startedAt       DateTime?
  endedAt         DateTime?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, status, createdAt])
  @@index([organisationId, createdAt])
}

/// Candidate agent config/prompt — promotion requires a passing EvalRun.
model AgentVersionCandidate {
  id                   String                      @id @default(cuid())
  organisationId       String
  agentConfigurationId String?
  label                String
  status               AgentVersionCandidateStatus @default(DRAFT)
  /// Proposed overrides: systemPromptExtra, model, brandTone, …
  configSnapshot       Json                        @default("{}")
  evalSuiteKey         String?
  lastEvalRunId        String?
  /// { passed, caseCount, failedKeys[], message } — never invent pass rates
  evalSummary          Json?
  promotedAt           DateTime?
  createdByUserId      String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agentConfiguration AgentConfiguration? @relation(fields: [agentConfigurationId], references: [id], onDelete: SetNull)
  evalRuns           EvalRun[]

  @@index([organisationId, status, createdAt])
  @@index([organisationId, agentConfigurationId])
}

/// Named suite of deterministic eval cases (org-scoped).
model EvalSuite {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  name           String
  description    String?  @db.Text
  /// [{ id, name, kind, expect }]
  cases          Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  runs         EvalRun[]

  @@unique([organisationId, key])
  @@index([organisationId, key])
}

model EvalRun {
  id             String        @id @default(cuid())
  organisationId String
  evalSuiteId    String?
  suiteKey       String
  candidateId    String?
  status         EvalRunStatus @default(PENDING)
  /// Per-case results; scores only when cases actually ran.
  results        Json          @default("{}")
  passed         Boolean?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  evalSuite    EvalSuite?             @relation(fields: [evalSuiteId], references: [id], onDelete: SetNull)
  candidate    AgentVersionCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, suiteKey, createdAt])
  @@index([candidateId])
}

// ─── Phase 10 — Enterprise entitlements + metering ──────────────────────────

/// Feature entitlement for a workspace. Prefer syncing from plan; rows override plan defaults.
model Entitlement {
  id             String   @id @default(cuid())
  organisationId String
  /// e.g. research | imaging | social_listening | automations | content_publish | learning
  capability     String
  enabled        Boolean  @default(true)
  /// Optional soft limit (e.g. research jobs / month). null = unlimited when enabled.
  limitValue     Int?
  /// Notes for operators — not shown as fake usage.
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, capability])
  @@index([organisationId, enabled])
}

/// Period meter counters — quantity only from real UsageRecord / AiExecution rollups.
model UsageMeter {
  id             String   @id @default(cuid())
  organisationId String
  /// Matches Entitlement.capability or ledger feature keys.
  meterKey       String
  /// UTC month start (YYYY-MM-01) for monthly meters.
  periodStart    DateTime
  quantity       Int      @default(0)
  /// Source of last sync: usage_record | ai_execution | manual
  source         String   @default("usage_record")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, meterKey, periodStart])
  @@index([organisationId, periodStart])
}

// ─── Phase 13A — Goal & KPI graph ────────────────────────────────────────────

enum GoalStatus {
  DRAFT
  ACTIVE
  AT_RISK
  ACHIEVED
  PAUSED
  CANCELLED
}

enum GoalCategory {
  REVENUE
  PIPELINE
  SALES
  CUSTOMER_ACQUISITION
  RETENTION
  CONTENT
  BRAND
  AUDIENCE_GROWTH
  OPERATIONAL
  CUSTOM
}

enum KpiAggregation {
  SUM
  AVG
  COUNT
  RATE
  LAST
}

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum KpiTargetComparator {
  GTE
  LTE
  EQ
  RANGE
  PCT_IMPROVEMENT
  ABS_IMPROVEMENT
}

enum InitiativeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum GoalLinkKind {
  RELATED_TO
  EXPECTED_TO_IMPACT
  MEASURED_IMPACT
  CONTRIBUTED_TO
}

model Goal {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  description    String?      @db.Text
  category       GoalCategory @default(CUSTOM)
  status         GoalStatus   @default(DRAFT)
  priority       Int          @default(100)
  ownerUserId    String?
  parentGoalId   String?
  startAt        DateTime?
  targetAt       DateTime?
  completedAt    DateTime?
  source         String       @default("user")
  createdByUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent       Goal?        @relation("GoalTree", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children     Goal[]       @relation("GoalTree")
  kpiTargets   KpiTarget[]
  initiatives  Initiative[]
  links        GoalLink[]
  missions     AgentMission[]
  opportunities BusinessOpportunity[]

  @@index([organisationId, status, priority])
  @@index([organisationId, category])
  @@index([parentGoalId])
}

model KpiDefinition {
  id               String         @id @default(cuid())
  organisationId   String
  key              String
  name             String
  description      String?        @db.Text
  unit             String
  aggregation      KpiAggregation @default(SUM)
  direction        KpiDirection   @default(HIGHER_IS_BETTER)
  /// Calculator registry key (deterministic).
  calculatorKey    String
  measurementFreq  String?        // e.g. daily | weekly | monthly
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targets      KpiTarget[]
  snapshots    KpiSnapshot[]
  opportunities BusinessOpportunity[]

  @@unique([organisationId, key])
  @@index([organisationId, calculatorKey])
}

model KpiTarget {
  id               String              @id @default(cuid())
  organisationId   String
  goalId           String
  kpiDefinitionId  String
  comparator       KpiTargetComparator @default(GTE)
  targetValue      Float
  targetValueMax   Float?
  baselineValue    Float?
  unit             String
  currency         String?
  deadlineAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  goal          Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)

  @@index([organisationId, goalId])
  @@index([organisationId, kpiDefinitionId])
  @@unique([goalId, kpiDefinitionId])
}

model KpiSnapshot {
  id                String   @id @default(cuid())
  organisationId    String
  kpiDefinitionId   String
  value             Float
  unit              String
  observedAt        DateTime
  source            String
  sourceReference   String?
  confidence        Float?
  calculationVersion String  @default("1")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)

  @@index([organisationId, kpiDefinitionId, observedAt])
  @@index([organisationId, observedAt])
}

model Initiative {
  id             String           @id @default(cuid())
  organisationId String
  goalId         String?
  name           String
  description    String?          @db.Text
  status         InitiativeStatus @default(DRAFT)
  /// Optional links to existing domain objects (IDs only).
  campaignId     String?
  experimentId   String?
  missionId      String?
  automationRuleId String?
  contentPieceId String?
  opportunityId  String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  goal         Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([organisationId, goalId])
}

/// Evidence-backed link from Goal/KPI to Mission/Opportunity/etc. — not automatic causation.
model GoalLink {
  id             String       @id @default(cuid())
  organisationId String
  goalId         String
  kind           GoalLinkKind @default(RELATED_TO)
  targetType     String
  targetId       String
  kpiDefinitionId String?
  note           String?      @db.Text
  createdAt      DateTime     @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, kind, targetType, targetId])
  @@index([organisationId, targetType, targetId])
}

// ─── Phase 13B — Business digital twin (relations over existing entities) ───

enum BusinessClaimStatus {
  CONFIRMED
  OBSERVED
  INFERRED
  DISPUTED
  STALE
}

enum ProductOfferingStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model ProductOffering {
  id             String                @id @default(cuid())
  organisationId String
  name           String
  description    String?               @db.Text
  category       String?
  priceMinCents  Int?
  priceMaxCents  Int?
  currency       String?               @default("GBP")
  status         ProductOfferingStatus @default(ACTIVE)
  targetAudience String?               @db.Text
  businessModel  String?
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
}

model AudienceSegment {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  description    String?  @db.Text
  /// Commercial attributes only — never protected/sensitive characteristics.
  attributes     Json     @default("{}")
  evidenceNote   String?  @db.Text
  confidence     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, name])
}

model EntityRelation {
  id                String    @id @default(cuid())
  organisationId    String
  sourceType        String
  sourceId          String
  relationshipType  String
  targetType        String
  targetId          String
  confidence        Float?
  source            String
  evidenceReference String?
  validFrom         DateTime?
  validUntil        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, sourceType, sourceId, relationshipType, targetType, targetId])
  @@index([organisationId, relationshipType])
  @@index([organisationId, targetType, targetId])
}

model BusinessClaim {
  id             String              @id @default(cuid())
  organisationId String
  subjectType    String
  subjectId      String
  predicate      String
  objectType     String?
  objectId       String?
  valueText      String?             @db.Text
  valueJson      Json?
  status         BusinessClaimStatus @default(OBSERVED)
  confidence     Float?
  source         String
  evidenceReference String?
  observedAt     DateTime            @default(now())
  validFrom      DateTime?
  validUntil     DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, subjectType, subjectId, predicate])
  @@index([organisationId, status, lastVerifiedAt])
}

// ─── Phase 13C — Opportunity graph (not CRM Deal) ───────────────────────────

enum BusinessOpportunityType {
  TREND
  CONTENT_GAP
  AUDIENCE_NEED
  COMPETITOR_GAP
  LEAD
  DEAL_RISK
  REACTIVATION
  UPSELL
  CROSS_SELL
  CAMPAIGN
  SEO
  AUTOMATION
  OPERATIONAL
  RESEARCH
  SOCIAL_PROSPECT
  CUSTOM
}

enum BusinessOpportunityStatus {
  DETECTED
  REVIEWED
  ACCEPTED
  REJECTED
  PLANNED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  DISMISSED
}

enum OpportunityConfidenceBand {
  LOW
  MEDIUM
  HIGH
}

enum OpportunityImpactBand {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum OpportunityUrgencyBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OpportunityOutcomeResult {
  SUCCESSFUL
  UNSUCCESSFUL
  INCONCLUSIVE
  IGNORED
}

model BusinessOpportunity {
  id                 String                     @id @default(cuid())
  organisationId     String
  type               BusinessOpportunityType
  title              String
  summary            String                     @db.Text
  status             BusinessOpportunityStatus  @default(DETECTED)
  impact             OpportunityImpactBand      @default(MEDIUM)
  urgency            OpportunityUrgencyBand     @default(MEDIUM)
  confidence         OpportunityConfidenceBand  @default(MEDIUM)
  /// Deterministic priority score (higher = more important). Factors in metadata.
  priorityScore      Float                      @default(0)
  estimatedEffort    String?
  estimatedValueCents Int?
  currency           String?
  goalId             String?
  kpiDefinitionId    String?
  ownerUserId        String?
  createdByAgent     String?
  createdByVersion   String?
  source             String
  /// Stable fingerprint for detector dedupe.
  dedupeKey          String
  detectedAt         DateTime                   @default(now())
  expiresAt          DateTime?
  reviewedAt         DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  executedAt         DateTime?
  completedAt        DateTime?
  scoreFactors       Json                       @default("{}")
  /// Phase 14F — quality gate (separate from lifecycle status).
  qualityGateStatus  OpportunityQualityGate     @default(PENDING_VERIFICATION)
  qualityAssessmentId String?
  verificationBudget VerificationBudget         @default(STANDARD)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  organisation  Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  goal          Goal?                @relation(fields: [goalId], references: [id], onDelete: SetNull)
  kpiDefinition KpiDefinition?       @relation(fields: [kpiDefinitionId], references: [id], onDelete: SetNull)
  evidences     OpportunityEvidence[]
  outcome       OpportunityOutcome?
  missions      AgentMission[]
  qualityAssessment QualityAssessment? @relation(fields: [qualityAssessmentId], references: [id], onDelete: SetNull)

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, status, priorityScore])
  @@index([organisationId, type, status])
  @@index([organisationId, expiresAt])
  @@index([organisationId, qualityGateStatus])
  @@index([goalId])
}

model OpportunityEvidence {
  id             String   @id @default(cuid())
  organisationId String
  opportunityId  String
  evidenceType   String
  evidenceId     String?
  label          String
  detail         String?  @db.Text
  createdAt      DateTime @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunity  BusinessOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([organisationId, opportunityId])
  @@index([evidenceType, evidenceId])
}

model OpportunityOutcome {
  id                String                   @id @default(cuid())
  organisationId    String
  opportunityId     String                   @unique
  result            OpportunityOutcomeResult @default(INCONCLUSIVE)
  summary           String?                  @db.Text
  /// Measured impact only when evidenced — never AI-guessed £.
  measuredValueCents Int?
  currency          String?
  kpiSnapshotBeforeId String?
  kpiSnapshotAfterId  String?
  userJudgement     String?
  agentEvaluation   String?                  @db.Text
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunity  BusinessOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model OpportunityDetectorRun {
  id               String   @id @default(cuid())
  organisationId   String
  detectorKey      String
  detectorVersion  String
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  createdCount     Int      @default(0)
  updatedCount     Int      @default(0)
  suppressedCount  Int      @default(0)
  errorSummary     String?  @db.Text
  metadata         Json     @default("{}")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, detectorKey, startedAt])
}

// ─── Phase 14 — Integration mesh / sync / skills ─────────────────────────────

enum ConnectorCapabilityStatus {
  AVAILABLE
  CONNECTED
  AUTH_REQUIRED
  SCOPE_REQUIRED
  APPROVAL_REQUIRED
  RESTRICTED
  DEGRADED
  UNSUPPORTED
  DISABLED
}

enum ConnectorConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  EXPIRED
  REVOKED
  ERROR
  DISABLED
}

enum SyncRunKind {
  FULL_INITIAL
  INCREMENTAL
  WEBHOOK
  MANUAL
  RECONCILIATION
}

enum SyncRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum SkillDefinitionStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  DISABLED
}

/// Per-org/capability status with provenance — not binary “connected”.
model ConnectorCapabilityState {
  id               String                     @id @default(cuid())
  organisationId   String
  providerKey      String
  /// SocialConnection id / Integration id / env-scoped key.
  connectionRef    String?
  capability       String
  status           ConnectorCapabilityStatus  @default(UNSUPPORTED)
  /// Why Agent Desk believes this status (scopes, probe, policy, docs).
  provenance       String
  grantedScopes    String[]                   @default([])
  missingScopes    String[]                   @default([])
  detail           String?                    @db.Text
  lastEvaluatedAt  DateTime                   @default(now())
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerKey, connectionRef, capability])
  @@index([organisationId, providerKey, status])
}

/// Maps Agent Desk entities ↔ provider objects without duplicating payloads.
model ExternalObjectMapping {
  id               String    @id @default(cuid())
  organisationId   String
  providerKey      String
  connectionRef    String?
  externalType     String
  externalId       String
  internalType     String
  internalId       String
  externalUrl      String?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  lastSyncedAt     DateTime?
  externalUpdatedAt DateTime?
  syncVersion      String?
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerKey, externalType, externalId])
  @@index([organisationId, internalType, internalId])
  @@index([organisationId, providerKey, lastSyncedAt])
}

model SyncCursor {
  id             String   @id @default(cuid())
  organisationId String
  providerKey    String
  connectionRef  String?
  resource       String
  /// Opaque provider cursor / updatedSince / sync token.
  cursorValue    String   @db.Text
  cursorKind     String   @default("opaque")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerKey, connectionRef, resource])
  @@index([organisationId, providerKey])
}

model SyncRun {
  id               String        @id @default(cuid())
  organisationId   String
  providerKey      String
  connectionRef    String?
  resource         String
  kind             SyncRunKind   @default(INCREMENTAL)
  status           SyncRunStatus @default(PENDING)
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  processedCount   Int           @default(0)
  createdCount     Int           @default(0)
  updatedCount     Int           @default(0)
  failedCount      Int           @default(0)
  cursorBefore     String?       @db.Text
  cursorAfter      String?       @db.Text
  errorSummary     String?       @db.Text
  metadata         Json          @default("{}")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, providerKey, startedAt])
  @@index([organisationId, status, startedAt])
}

model ConnectorRateLimitState {
  id             String    @id @default(cuid())
  organisationId String
  providerKey    String
  connectionRef  String?
  operationClass String    @default("default")
  remaining      Int?
  resetAt        DateTime?
  backoffUntil   DateTime?
  last429At      DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerKey, connectionRef, operationClass])
  @@index([organisationId, backoffUntil])
}

model ConnectorCircuitState {
  id               String       @id @default(cuid())
  organisationId   String
  providerKey      String
  connectionRef    String?
  operationClass   String       @default("default")
  state            CircuitState @default(CLOSED)
  failureCount     Int          @default(0)
  openedAt         DateTime?
  halfOpenAt       DateTime?
  lastFailureAt    DateTime?
  lastSuccessAt    DateTime?
  lastErrorSummary String?      @db.Text
  updatedAt        DateTime     @updatedAt
  createdAt        DateTime     @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerKey, connectionRef, operationClass])
  @@index([organisationId, state])
}

/// Bounded health history — do not ping providers continuously.
model ProviderHealthEvent {
  id             String   @id @default(cuid())
  organisationId String
  providerKey    String
  connectionRef  String?
  status         ConnectorConnectionStatus
  source         String
  latencyMs      Int?
  errorCode      String?
  summary        String?  @db.Text
  observedAt     DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, providerKey, observedAt])
}

/// Built-in or org-scoped Skill definitions (versioned; not arbitrary customer code).
model SkillDefinition {
  id             String                @id @default(cuid())
  organisationId String?
  /// Null organisationId = system/built-in skill.
  key            String
  version        String
  name           String
  description    String                @db.Text
  inputSchema    Json                  @default("{}")
  outputSchema   Json                  @default("{}")
  requiredTools  String[]              @default([])
  optionalTools  String[]              @default([])
  allowedAgents  String[]              @default([])
  risk           String                @default("read")
  budgetHintCents Int?
  evalSuiteKey   String?
  status         SkillDefinitionStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  executions   SkillExecution[]

  @@unique([organisationId, key, version])
  @@index([key, status])
}

model SkillExecution {
  id               String   @id @default(cuid())
  organisationId   String
  skillDefinitionId String
  skillKey         String
  skillVersion     String
  agentRunId       String?
  missionId        String?
  status           String   @default("COMPLETED")
  inputSummary     String?  @db.Text
  outputSummary    String?  @db.Text
  createdAt        DateTime @default(now())

  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  skillDefinition SkillDefinition @relation(fields: [skillDefinitionId], references: [id], onDelete: Cascade)

  @@index([organisationId, skillKey, createdAt])
  @@index([organisationId, agentRunId])
}

/// Bounded operation audit for connector actions (no secrets).
model ConnectorOperationLog {
  id             String   @id @default(cuid())
  organisationId String
  providerKey    String
  connectionRef  String?
  operation      String
  toolName       String?
  success        Boolean
  latencyMs      Int?
  errorCode      String?
  errorSummary   String?  @db.Text
  costCents      Int?
  missionId      String?
  toolCallId     String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, providerKey, createdAt])
  @@index([organisationId, success, createdAt])
}

// ─── Phase 14F — Intelligence Quality & Verification ─────────────────────────

enum VerificationBudget {
  FAST
  STANDARD
  DEEP
  MISSION_CRITICAL
}

/// Quality gate on material recommendations / opportunities (deterministic dimensions).
enum OpportunityQualityGate {
  PENDING_VERIFICATION
  PASSED
  NEEDS_MORE_RESEARCH
  CONFLICTED
  INSUFFICIENT_EVIDENCE
  STALE
  REJECTED
}

enum IntelligenceClaimStatus {
  EXTRACTED
  CORROBORATED
  CONFLICTED
  INSUFFICIENT
  REJECTED
}

/// Atomic claim extracted from research / social / twin signals.
model IntelligenceClaim {
  id               String                  @id @default(cuid())
  organisationId   String
  researchJobId    String?
  text             String                  @db.Text
  /// Normalised fingerprint for dedupe (hash of normalised text + entity keys).
  normalisedKey    String
  claimKind        String                  @default("FACT")
  status           IntelligenceClaimStatus @default(EXTRACTED)
  /// Transparent dimension scores 0–1 — never LLM-invented percentages as truth.
  authorityScore   Float?
  freshnessScore   Float?
  corroborationScore Float?
  independenceScore Float?
  audienceRelevanceScore Float?
  platformRelevanceScore Float?
  geoRelevanceScore Float?
  sampleSizeScore  Float?
  socialQualityScore Float?
  survivorshipRisk Float?
  negativeEvidenceScore Float?
  dimensions       Json                    @default("{}")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  evidenceLinks ClaimEvidenceLink[]
  assessments   QualityAssessmentClaim[]

  @@unique([organisationId, normalisedKey])
  @@index([organisationId, status, createdAt])
  @@index([organisationId, researchJobId])
}

model ClaimEvidenceLink {
  id                   String   @id @default(cuid())
  organisationId       String
  claimId              String
  researchSourceId     String?
  researchSnapshotId   String?
  researchFindingId    String?
  providerKey          String?
  sourceUrl            String?
  retrievedAt          DateTime?
  lineageKey           String?
  supports             Boolean  @default(true)
  excerpt              String?  @db.Text
  createdAt            DateTime @default(now())

  claim IntelligenceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([organisationId, lineageKey])
  @@index([organisationId, researchSnapshotId])
}

model QualityAssessment {
  id               String                  @id @default(cuid())
  organisationId   String
  subjectKind      String
  subjectId        String
  budget           VerificationBudget      @default(STANDARD)
  gateStatus       OpportunityQualityGate  @default(PENDING_VERIFICATION)
  /// Deterministic dimension breakdown — never treat as calibrated probability.
  dimensions       Json                    @default("{}")
  criticNotes      String?                 @db.Text
  escalationReason String?                 @db.Text
  consequenceLevel String                  @default("MEDIUM")
  assessedAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organisation  Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  claims        QualityAssessmentClaim[]
  opportunities BusinessOpportunity[]

  @@index([organisationId, subjectKind, subjectId])
  @@index([organisationId, gateStatus, assessedAt])
}

model QualityAssessmentClaim {
  id                   String @id @default(cuid())
  qualityAssessmentId  String
  claimId              String
  role                 String @default("PRIMARY")

  assessment QualityAssessment @relation(fields: [qualityAssessmentId], references: [id], onDelete: Cascade)
  claim      IntelligenceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([qualityAssessmentId, claimId])
  @@index([claimId])
}

// ─── Phase 16 — Continuous intelligence / Prediction Lab ─────────────────────

enum PredictionEvaluationStatus {
  PENDING
  SCORED
  EXPIRED
  INVALID
}

model ContinuousCollectionRun {
  id             String   @id @default(cuid())
  organisationId String
  kind           String
  providerKey    String?
  status         String   @default("COMPLETED")
  observedAt     DateTime @default(now())
  itemsCollected Int      @default(0)
  errorSummary   String?  @db.Text
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, kind, observedAt])
}

/// Prediction Lab — record predictions for later scoring (no fake accuracy claims).
model IntelligencePrediction {
  id               String   @id @default(cuid())
  organisationId   String
  predictionType   String
  statement        String   @db.Text
  horizonAt        DateTime
  features         Json     @default("{}")
  modelVersion     String   @default("rules-v1")
  /// Transparent band — not calibrated probability until Phase 17 has samples.
  confidenceBand   String   @default("MEDIUM")
  expectedOutcome  Json     @default("{}")
  actualOutcome    Json?
  evaluationStatus PredictionEvaluationStatus @default(PENDING)
  trendClusterId   String?
  qualityAssessmentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  scoredAt         DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  evaluations  PredictionEvaluation[]

  @@index([organisationId, predictionType, evaluationStatus])
  @@index([organisationId, horizonAt])
  @@index([organisationId, trendClusterId])
}

model PredictionEvaluation {
  id             String   @id @default(cuid())
  organisationId String
  predictionId   String
  /// Metrics only when ground truth exists — never fabricate.
  directionCorrect Boolean?
  precisionNote  String?  @db.Text
  metrics        Json     @default("{}")
  scorerVersion  String   @default("rules-v1")
  createdAt      DateTime @default(now())

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  prediction   IntelligencePrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([organisationId, predictionId])
}

// ─── Phase 17 — Evaluation / calibration (extends learning-os) ───────────────

model ConfidenceCalibrationSample {
