  EXECUTING
  COMPLETED
  CANCELLED
  REJECTED
}

enum CreativePatternMaturity {
  INSUFFICIENT_DATA
  EMERGING_PATTERN
  SUPPORTED_PATTERN
  STRONG_PATTERN
